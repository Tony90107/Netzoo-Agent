+"""Harness repair A2' (ROUND-A.md): a required declaration the check never read is witnessed by its own control's name.
+
+h7 S16, both rounds: the agent asked "Did you log-transform the values?" on "I can't remember whether I log-transformed
+the values first", citing BONOBO's declaration; the check had read nothing on that sentence, R1 dropped the question
+and BONOBO ran. A required declaration (BONOBO's log_transformed, centered) whose control the user's words and the cited
+contract words both name now passes R1; every other rule still holds.
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parents[1] / "scripts"))
+
+from netzoo_agent_core.contracts import TaskDecision  # noqa: E402
+from netzoo_agent_core.contracts.capability_check import CapabilityCheck, CheckedRequirement  # noqa: E402
+from netzoo_agent_core.contracts.fact_check import FactProposal, FactProposals  # noqa: E402
+from netzoo_agent_core.interpretation.fact_check import declaration_doubt, kept_facts  # noqa: E402
+from netzoo_agent_core.policy import ProjectPolicyLoader  # noqa: E402
+
+TASK = ("Run BONOBO on islet_expr.tsv (12 human islet donors, genes in rows) and write .h5 output to bonobo_islets/. "
+        "I centred every gene myself, but I can't remember whether I log-transformed the values first.")
+DOUBT = "I can't remember whether I log-transformed the values first."
+CONTRACT = ("The agent requires the caller to declare log_transformed=true and centered=true because BONOBO assumes "
+            "log-transformed centered expression.")
+
+
+@pytest.fixture(scope="module")
+def policy():
+    return ProjectPolicyLoader(Path(__file__).parents[1]).load()
+
+
+def proposal(question="Did you log-transform the values?", words=DOUBT, contract=CONTRACT, workflow="BONOBO"):
+    return FactProposal(user_quote=words, uncertainty="said_unknown", workflow=workflow, contract_quote=contract,
+                        question=question, yes_outcome="supported", yes_workflow="", no_outcome="not_supported",
+                        no_workflow="", about="user_data", alternatives=[])
+
+
+def decision(task=TASK, settings=()):
+    row = CheckedRequirement(kind="result", quote=task.split(". ")[0], status="available",
+                             delivered_by=["bonobo.per_sample_networks"],
+                             method={"named": "BONOBO", "named_quote": "BONOBO", "settings": list(settings)})
+    return TaskDecision(action="no_tool", in_scope=True, should_execute=False, confidence=0.9, reason="r",
+                        matched_actions=["run_bonobo"], capability_check=CapabilityCheck(requirements=[row]))
+
+
+def test_the_s16_question_is_kept_though_the_check_read_nothing_there(policy):
+    found = kept_facts(TASK, FactProposals(facts=[proposal()]), decision(), policy)
+    assert [fact.question for fact in found.accepted] == ["Did you log-transform the values?"]
+
+
+def test_a_question_on_another_declaration_than_the_words_name_is_dropped(policy):
+    """S16's second proposal: centering, on the log-transform sentence."""
+    found = kept_facts(TASK, FactProposals(facts=[proposal("Did you center the values?")]), decision(), policy)
+    assert found.accepted == [] and found.rejected[0].rule.startswith("R1 the check did not read")
+    centring = proposal("Did you center the values?", words="I centred every gene myself")
+    assert not declaration_doubt(TASK, centring)  # "centred" does not begin "centered"; R1 decides as before
+
+
+def test_the_question_must_ask_about_the_declaration():
+    assert not declaration_doubt(TASK, proposal("Which BONOBO version did you install?"))
+
+
+def test_a_workflow_without_required_declarations_has_no_such_witness():
+    assert not declaration_doubt(TASK, proposal(workflow="PANDA"))
+
+
+def test_contract_words_that_do_not_name_the_control_are_no_witness():
+    assert not declaration_doubt(TASK, proposal(contract="BONOBO assumes centered expression with genes on rows."))
+
+
+def test_words_not_in_the_request_are_no_witness():
+    assert not declaration_doubt(TASK, proposal(words="I never log-transformed anything"))
+
+
+def test_words_the_reading_typed_as_a_stated_setting_are_still_dropped_by_r4(policy):
+    start = TASK.index(DOUBT)
+    stated = {"name": "BONOBO.log_transformed", "quote": DOUBT, "value": "true", "span": [start, start + len(DOUBT)]}
+    found = kept_facts(TASK, FactProposals(facts=[proposal()]), decision(settings=[stated]), policy)
+    assert found.accepted == [] and found.rejected[0].rule == "R4 the reading typed it as stated"
