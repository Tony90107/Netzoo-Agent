+def _declaration_doubts(task, decision, check):
+    """Harness repair A2': the recorded proposals R1 dropped only for want of the check's witness that today's
+    `declaration_doubt` witnesses, re-judged by today's `kept_facts` (R2-R7). None without that function."""
+    from netzoo_agent_core.contracts.fact_check import FactProposal, FactProposals
+    from netzoo_agent_core.interpretation.fact_check import declaration_doubt, kept_facts
+    from netzoo_agent_core.interpretation.menu_requirements import _policy
+
+    found = []
+    for rejected in decision.fact_check.rejected:
+        if not rejected.rule.startswith("R1 the check did not read"):
+            continue
+        try:
+            proposal = FactProposal.model_validate(rejected.proposal)
+        except ValueError:
+            continue  # recorded before the proposal's current fields
+        if declaration_doubt(task, proposal):
+            found.append(proposal)
+    if not found:
+        return []
+    again = kept_facts(task, FactProposals(facts=found), decision.model_copy(update={"capability_check": check}),
+                       _policy())
+    return [*again.accepted, *again.queued]
 
 
