+def declaration_doubt(task: str, proposal) -> bool:
+    """Harness repair A2' (ROUND-A.md): R1's witness for a required declaration the check never read.
+
+    A required declaration (`judgment_defaults.required_settings`: BONOBO's log_transformed, centered) is asked when
+    not stated, never assumed (user decision 2026-10-19 (a)). h7 S16 (both rounds): "I centred every gene myself, but
+    I can't remember whether I log-transformed the values first" -- the agent asked "Did you log-transform the
+    values?" citing BONOBO's declaration; the check read no row and no unknown on that sentence, so R1 dropped it and
+    BONOBO ran. Here the user's words, the agent's question and the cited contract words all name the same declared
+    control (its second proposal, "Did you center the values?" on the same words, names another); R2-R7 (R4: words
+    the reading typed as stated) still hold.
+    """
+    from ..judgment_defaults import judgment_defaults
+    from ..workflow_conditions import control_named
+
+    required = judgment_defaults().required_settings
+    workflow = next((name for name in required if name.upper() == (proposal.workflow or "").strip().upper()), None)
+    if workflow is None or not proposal.user_quote.strip() or _span(task, proposal.user_quote) is None:
+        return False
+    return any(control_named(control, proposal.user_quote, stems=True) and control_named(control, proposal.question,
+                                                                                   stems=True)
+               and control_named(control, proposal.contract_quote) for control in required[workflow])
+
+
