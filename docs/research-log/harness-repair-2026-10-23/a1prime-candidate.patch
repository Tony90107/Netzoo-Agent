+
+    sentence = next((task[s:e] for s, e in request_sentences(task) if s <= span[0] < e), "")
+    return len(set(workflows_in(sentence))) > 1 and bool(ALTERNATIVE.search(sentence))
+
+
+def _anchors(check, task: str) -> bool:
