+def _lone_reading(hypotheses):
+    """Readings that all carry one outcome are one reading (Log 300).
+
+    Blind case 7 once came back as two identical per-sample multi-omic
+    readings. Counted as two, neither rule here applied, and the unstated
+    scale chose LIONESS-DRAGON on the unverified-evidence path.
+    """
+    if hypotheses and len({item.outcome.model_dump_json() for item in hypotheses}) == 1:
+        return [hypotheses[0]]
+    return list(hypotheses)
+
