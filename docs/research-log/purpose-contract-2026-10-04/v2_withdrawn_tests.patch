diff --git a/tests/test_study_purpose.py b/tests/test_study_purpose.py
index b6a3947..42be521 100644
--- a/tests/test_study_purpose.py
+++ b/tests/test_study_purpose.py
@@ -199,3 +199,49 @@ def test_the_trace_event_reads_the_request_only(monkeypatch):
     assert events[0][0] == "routing.study_purpose_detected"
     assert events[0][1]["design"] == "paired" and events[0][1]["claims"][0]["claim"] == "causal"
     assert len(events) == 2 and events[1][1]["claims"] == []
+
+
+# -- v2 witnesses (Log 344) ---------------------------------------------------------
+
+FIRST_HELDOUT = json.loads(
+    (ROOT / "docs" / "research-log" / "purpose-contract-2026-10-04" / "heldout" / "heldout.json").read_text())["items"]
+
+
+@pytest.mark.parametrize("item", FIRST_HELDOUT, ids=lambda item: item["id"])
+def test_the_first_held_out_set_now_development_data_keeps_its_labels(item):
+    # v2 was written against these (v1 found 4 of 22 designs); a later change must not lose them.
+    purpose = study_purpose(item["prompt"])
+    assert (purpose.design or "none", purpose.claim or "none") == (item["comparison_design"], item["claim_kind"])
+
+
+@pytest.mark.parametrize("task", [
+    "We checked the expression distributions before and after normalization; which network method fits?",
+    "We filtered the prior before network inference and after removing lowly expressed genes.",
+    "We have TF and miRNA regulators versus target genes; build one network.",
+    "Compare PANDA versus OTTER on our 50 samples.",
+    "Much of the variance is attributable to batch effects in our 3 batches and 2 lanes.",
+    "Our prior combines predicted binding sites and sequence-based target prediction from TargetScan.",
+    "We have 24 patients and 48 samples of RNA-seq.",
+    "We profiled 300 genes and 40 TFs in 20 tumors.",
+    "We have high and low expression genes in our 30 samples.",
+    "We sequenced 10 tumors at two sites and at a reference lab.",
+])
+def test_processing_steps_data_types_and_unit_counts_are_no_design(task):
+    purpose = study_purpose(task)
+    assert purpose.design is None and purpose.claims == ()
+
+
+@pytest.mark.parametrize("task, design", [
+    ("Blood was drawn from 22 asthma patients at enrollment and again after six months of inhaled steroids.", "paired"),
+    ("Tumor and matched normal tissue from 30 patients were profiled.", "paired"),
+    ("We have 3 visits per participant over a year.", "paired"),
+    ("We have 15 vehicle-treated and 15 drug-treated rats, liver RNA-seq.", "groups"),
+    ("Liver from young and aged mice was sequenced.", "groups"),
+])
+def test_designs_stated_with_counts_moments_or_contrasting_groups(task, design):
+    assert study_purpose(task).design == design
+
+
+def test_v2_causal_and_predictive_phrasings():
+    assert study_purpose("We want to attribute these expression changes to the knockout itself.").claim == "causal"
+    assert study_purpose("Can network features identify responders in an independent validation cohort?").claim == "prediction"
