+
+
+# -- Log 363 (a''): recommend the tied workflows the question and the named data favour --------
+
+def _tie(actions):
+    return TaskDecision(
+        action="no_tool", in_scope=True, should_execute=False, intent_type="answer_question", confidence=.9,
+        reason="Tie", capability_match_status="ambiguous", match_basis="semantic", hypothesis_actions=actions)
+
+
+def _purpose(design, claim, quote="q"):
+    from netzoo_agent_core.routing.study_purpose import StudyPurpose
+    return StudyPurpose(design, "d", ((claim, quote),) if claim else ())
+
+
+def test_a_per_individual_question_recommends_the_per_sample_workflows_with_named_priors():
+    from netzoo_agent_core.interpretation.study_purpose_notes import recommended_actions
+    task = "RNA-seq at baseline and 6 h after endotoxin, plus a human motif prior and PPI network. Which volunteers changed most?"
+    decision = _tie(["run_panda", "run_puma", "run_lioness_panda", "run_lioness_puma", "run_otter", "run_giraffe"])
+    assert recommended_actions(decision, _purpose("paired", "individual_change"), task) == [
+        "run_lioness_panda", "run_giraffe"]
+
+
+def test_no_priors_or_no_mirna_named_narrows_the_recommendation():
+    from netzoo_agent_core.interpretation.study_purpose_notes import recommended_actions
+    decision = _tie(["run_panda", "run_lioness_panda", "run_lioness_coexpression", "run_bonobo"])
+    task = "Blood RNA-seq from 40 patients sampled twice; expression is all we have. Which patients changed most?"
+    assert recommended_actions(decision, _purpose("paired", "individual_change"), task) == [
+        "run_lioness_coexpression", "run_bonobo"]
+
+
+@pytest.mark.parametrize("claim, actions", [
+    # Every candidate has a cell: the question does not separate them.
+    ("group_difference", ["run_panda", "run_puma", "run_otter", "run_giraffe"]),
+    # No stated conclusion, or a causal one: nothing to recommend for.
+    (None, ["run_panda", "run_lioness_panda"]),
+    ("causal", ["run_panda", "run_lioness_panda"]),
+])
+def test_nothing_is_recommended_when_the_question_does_not_separate(claim, actions):
+    from netzoo_agent_core.interpretation.study_purpose_notes import recommended_actions
+    task = "RNA-seq before and after treatment with motif and PPI priors."
+    assert recommended_actions(_tie(actions), _purpose("paired", claim), task) == []
+
+
+def test_two_named_omics_layers_prefer_the_multi_omic_workflow():
+    from netzoo_agent_core.interpretation.study_purpose_notes import recommended_actions
+    task = "RNA-seq and methylation arrays on 40 tumours from two clinics. Which tumours have the most atypical networks?"
+    decision = _tie(["run_panda", "run_lioness_coexpression", "run_lioness_dragon"])
+    assert recommended_actions(decision, _purpose("groups", "individual_change"), task) == ["run_lioness_dragon"]
