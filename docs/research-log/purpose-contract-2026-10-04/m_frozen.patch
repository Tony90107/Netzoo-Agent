+@pytest.mark.parametrize("task, quote", [
+    ("We have RNA-seq from six deceased organ donors, each contributing samples from about 40 different tissues.",
+     "each contributing samples from about 40 different tissues"),
+    ("Three adults with type 1 diabetes gave blood weekly for a year, with RNA-seq of each draw.",
+     "gave blood weekly for a year"),
+    ("We collected 30 biopsies per donor from four donors.", "30 biopsies per donor"),
+    # The quote's sentence supplies "each" (heldout10 T1, seen): the cue overlaps the quote.
+    ("We have RNA-seq from six deceased organ donors, each contributing samples from about 40 different tissues, "
+     "plus a motif prior.", "samples from about 40 different tissues"),
+    ("Each of five patients had dozens of tumour regions sequenced.", "dozens of tumour regions sequenced"),
+])
+def test_many_samples_from_each_individual_are_kept_on_their_quote(task, quote):
+    purpose, rejected = verify_proposal(task, _proposal(many=quote))
+    assert purpose.many_samples_quote == quote and rejected == []
+
+
+@pytest.mark.parametrize("task, quote", [
+    # One sample per time point, a few time points, or numbers that count individuals or days.
+    ("Liver biopsies from 22 patients, each sampled before and after ten days on the diet.",
+     "each sampled before and after ten days on the diet"),
+    ("From each of 15 patients we took one lesional and one perilesional biopsy.",
+     "From each of 15 patients we took one lesional and one perilesional biopsy"),
+    ("Nine macaques were bled on days 0, 3, 7, 14 and 28 after vaccination.", "bled on days 0, 3, 7, 14 and 28"),
+    ("We have blood RNA-seq from 40 patients.", "blood RNA-seq from 40 patients"),
+    # A cue elsewhere in the sentence that the quote does not reach.
+    ("We have blood RNA-seq from 40 patients, and the ward logs vitals weekly.", "blood RNA-seq from 40 patients"),
+    ("Each mouse was sampled at three time points.", "Each mouse was sampled at three time points"),
+])
+def test_one_or_a_few_samples_per_individual_are_not_many(task, quote):
+    purpose, rejected = verify_proposal(task, _proposal(many=quote))
+    assert purpose.many_samples_quote == ""
+    assert rejected and rejected[0]["field"] == "many_samples"
+
