+"""Regressions from new model readings, including failed evidence and modifier ownership."""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parents[1] / "scripts"))
+
+from netzoo_agent_core.contracts import TaskDecision
+from netzoo_agent_core.contracts.capability_check import proposal_model
+from netzoo_agent_core.contracts.fact_check import FactProposals
+from netzoo_agent_core.interpretation.capability_check import build_capability_check
+from netzoo_agent_core.interpretation.checked_match import checked_match
+from netzoo_agent_core.interpretation.core_decision import decide_core
+from netzoo_agent_core.interpretation.fact_check import kept_facts
+from netzoo_agent_core.interpretation.method_conditions import verified_controls
+from netzoo_agent_core.policy import ProjectPolicyLoader
+
+CASES = json.loads((Path(__file__).parent / "fixtures/judgment_repairs/fresh_readings.json").read_text())
+
+
+def build(case):
+    row = CASES[case]
+    raw = row["proposal"]
+    proposal = proposal_model(sum(k[1:].isdigit() for k in raw)).model_validate(raw)
+    check, rejected = build_capability_check(row["task"], proposal)
+    return row, check, rejected
+
+
+@pytest.mark.parametrize("case,workflow", [("H21", "PANDA"), ("H37", "CONDOR"), ("J17", "SAMBAR")])
+def test_explicit_command_is_the_analysis_even_if_model_only_read_its_modifiers(case, workflow):
+    row, check, rejected = build(case)
+    policy = ProjectPolicyLoader(Path(__file__).parents[1]).load()
+    decision = TaskDecision(action="no_tool", in_scope=True, should_execute=False, confidence=0.0,
+                            match_basis="provider_unavailable", reason="routing failed", capability_check=check)
+    decision = checked_match(decision, policy.workflows)
+    core = decide_core(decision, row["task"], reason_code="semantic_fallback")
+    assert core.kind == "DO" and core.workflows == [workflow]
+    assert not any(item.status == "not_available" for item in check.results())
+    if case == "J17":
+        values = verified_controls(check, "run_sambar")
+        assert values["norm_patient"] is True and values["gmt_msigdb"] is False
+
+
+def test_explicit_raw_doubt_can_support_the_fact_reader_when_the_first_reader_omits_it():
+    row, check, rejected = build("M01")
+    policy = ProjectPolicyLoader(Path(__file__).parents[1]).load()
+    decision = TaskDecision(action="no_tool", in_scope=True, should_execute=False, confidence=0.9,
+                            reason="read", matched_actions=["run_lioness_dragon"], capability_check=check)
+    proposals = FactProposals.model_validate({"facts": row["fact_proposals"]})
+    facts = kept_facts(row["task"], proposals, decision, policy)
+    assert facts.accepted and "300" in facts.accepted[0].user_quote and "5,000" in facts.accepted[0].user_quote
+    core = decide_core(decision.model_copy(update={"fact_check": facts}), row["task"])
+    assert core.kind == "ASK" and "300" in core.facts[0].question
+
+
+def test_literal_unsupported_parameter_cannot_be_renamed_to_an_existing_parameter():
+    row, check, rejected = build("H18")
+    decision = TaskDecision(action="no_tool", in_scope=True, should_execute=False, confidence=0.9,
+                            reason="read", capability_check=check)
+    core = decide_core(decision, row["task"])
+    assert core.kind == "DECLINE"
+    assert any("lambda_inter" in reason and "no setting" in reason
