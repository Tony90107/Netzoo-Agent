+def _core(check, task, action="no_tool"):
+    from netzoo_agent_core.contracts import TaskDecision
+    from netzoo_agent_core.interpretation.core_decision import decide_core
+    return decide_core(TaskDecision(action=action, in_scope=True, should_execute=action != "no_tool",
+                                     confidence=1.0, reason="regression", capability_check=check), task)
+
+
+def test_frozen_h34_reading_reaches_delta_refusal_and_opposite_control():
+    from test_method_conditions import _ask, _check
+    for switch, expected in (("sparsify", "DECLINE"), ("do not sparsify", "DO")):
+        task = f"For BONOBO, please {switch} at confidence 0.05 and fix delta at 0.4."
+        check = _check(task, _ask(task, ["bonobo.per_sample_networks"], named="BONOBO", named_quote="BONOBO",
+                                 scale="per_sample", settings=[
+                                     ("BONOBO.sparsify", f"{switch} at confidence 0.05", "0.05"),
+                                     ("BONOBO.delta", "fix delta at 0.4", "0.4")]))
+        core = _core(check, task)
+        assert core.kind == expected
