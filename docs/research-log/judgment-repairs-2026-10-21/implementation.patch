+def test_unparsed_numeric_value_waits_but_explicit_estimation_keeps_default():
+    conditions = conditions_for("SAMBAR")
+    setting = {"name": "SAMBAR.kmax", "quote": "kmax very small", "value": "very small"}
+    assert methods.stated_no_value(conditions.settings["kmax"], setting) is False
+    assert methods.unresolved_settings({"named": "SAMBAR", "settings": [setting]}, ["sambar.subtypes"])
+    assert methods.run_setting_value(conditions.settings["kmax"], conditions, setting) is None
+    dragon = conditions_for("DRAGON")
+    estimated = {"name": "DRAGON.lambda1", "quote": "Leave lambda1 empty so it is estimated", "value": "empty"}
+    assert methods.stated_no_value(dragon.settings["lambda1"], estimated) is True
+    assert not methods.unresolved_settings({"named": "DRAGON", "settings": [estimated]}, ["dragon.two_layer_network"])
