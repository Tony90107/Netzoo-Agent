+@pytest.mark.parametrize("maximum,blocked", [(8, True), (6, False)])
+def test_m25_recovers_subtype_range_with_evidence_and_run_binding(maximum, blocked):
+    phrase = f"trying anywhere from 2 to {maximum} subtypes"
+    task = f"Set SAMBAR going on mut_pilot.csv (6 tumours x 900 genes), {phrase}. Results go to sambar_pilot/."
+    method = methods.verified_method(task, reading("SAMBAR", "SAMBAR", samples=6,
+                                                 samples_quote="6 tumours", ask=task[:100]))
+    settings = {s["name"]: s for s in method.get("settings", [])}
+    assert set(settings) == {"SAMBAR.kmin", "SAMBAR.kmax"}
+    conditions = conditions_for("SAMBAR")
+    for name, expected in (("kmin", 2), ("kmax", maximum)):
+        setting = settings[f"SAMBAR.{name}"]
+        assert task[slice(*setting["span"])] == phrase == setting["quote"]
+        assert methods.run_setting_value(conditions.settings[name], conditions, setting) == expected
+    stated = [StatedSetting(s["name"], s["quote"], s["value"]) for s in settings.values()]
+    assert bool(combination_issues(conditions, stated, samples=6)) is blocked
+
+
+@pytest.mark.parametrize("task,method,quote", [
+    ("Run BONOBO, trying anywhere from 2 to 8 subtypes.", "BONOBO", "BONOBO"),
+    ("Run SAMBAR with 2 to 8 genes in the pathway list.", "SAMBAR", "SAMBAR"),
+    ("Run SAMBAR on mutations. Run another clustering, trying anywhere from 2 to 8 subtypes.", "SAMBAR", "SAMBAR"),
+    ("Run SAMBAR then CONDOR, trying anywhere from 2 to 8 subtypes.", "SAMBAR", "SAMBAR"),
+])
+def test_range_recovery_does_not_reassign_other_analyses_or_data_ranges(task, method, quote):
+    assert not methods.verified_method(task, reading(method, quote, ask=task)).get("settings")
