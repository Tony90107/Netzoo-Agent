+"""Source-grounded regressions for H34, J17 and M25; no model calls or scientific runs."""
+from pathlib import Path
+from types import SimpleNamespace
+import sys
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parents[1] / "scripts"))
+
+from netzoo_agent_core.interpretation import method_conditions as methods
+from netzoo_agent_core.workflow_conditions import (
+    StatedSetting, boolean_value, combination_issues, conditions_for, setting_issue,
+)
+
+
+def reading(method, quote, *, settings=(), samples=None, samples_quote="", ask=""):
+    return SimpleNamespace(named_method=method, named_method_quote=quote, quote=ask,
+                           settings=[SimpleNamespace(name=n, quote=q, value_quote=v) for n, q, v in settings],
+                           sample_count=samples, sample_count_quote=samples_quote, feature_counts=[])
+
+
+@pytest.mark.parametrize("value", ["0.05", "0.5", "1.25", "confidence 0.05", "1e-3", "option1", "utf8"])
+def test_decimal_fragments_are_never_boolean_tokens(value):
+    assert boolean_value(value) is None
+
+
+@pytest.mark.parametrize("value,quote,expected", [
+    ("keep", "keep the normalization by each patient's mutation burden", True),
+    ("keep", "keep normalization off", False),
+    ("keep false", "keep normalization false", False),
+    ("keep true", "keep normalization true", True),
+    ("keep the normalization by each patient's mutation burden.", "", True),
+    ("keep normalization off.", "", False),
+    ("maybe keep normalization", "", None),
+    ("keep current settings", "", None),
+    ("0", "", False), ("1", "", True), ("keep", "", None),
+])
+def test_keep_requires_context_and_preserves_negation(value, quote, expected):
+    assert boolean_value(value, quote) is expected
+
+
+def test_h34_confidence_and_switch_are_separate_and_the_run_uses_both():
+    task = "For BONOBO, please sparsify at confidence 0.05 and fix delta at 0.4."
+    method = methods.verified_method(task, reading("BONOBO", "BONOBO", settings=[
+        ("BONOBO.sparsify", "sparsify at confidence 0.05", "0.05"),
+        ("BONOBO.delta", "fix delta at 0.4", "0.4"),
+    ], ask=task))
+    settings = {s["name"]: s for s in method["settings"]}
+    assert settings["BONOBO.sparsify"]["value"] != "0.05"
+    assert settings["BONOBO.bonobo_confidence"]["value"] == "0.05"
+    conditions = conditions_for("BONOBO")
+    assert methods.run_setting_value(conditions.settings["sparsify"], conditions,
+                                     settings["BONOBO.sparsify"]) is True
+    assert methods.run_setting_value(conditions.settings["bonobo_confidence"], conditions,
+                                     settings["BONOBO.bonobo_confidence"]) == .05
+    stated = [StatedSetting(s["name"], s["quote"], s["value"]) for s in settings.values()]
+    assert any("delta" in issue for issue in combination_issues(conditions, stated))
+    # The same delta is allowed with an explicit no; decimal confidence cannot reverse that no.
+    disabled = task.replace("please sparsify", "do not sparsify")
+    method = methods.verified_method(disabled, reading("BONOBO", "BONOBO", settings=[
+        ("BONOBO.sparsify", "do not sparsify at confidence 0.05", "0.05"),
+        ("BONOBO.delta", "fix delta at 0.4", "0.4"),
+    ], ask=disabled))
+    stated = [StatedSetting(s["name"], s["quote"], s["value"]) for s in method["settings"]]
+    assert not combination_issues(conditions, stated)
+
+
+@pytest.mark.parametrize("prefix,expected", [("please", True), ("do not", False), ("maybe", None)])
+def test_explicit_sparsify_operation_is_preserved_when_only_its_confidence_was_read(prefix, expected):
+    phrase = "sparsify at confidence 0.05"
+    task = f"For BONOBO, {prefix} {phrase} and fix delta at 0.4."
+    method = methods.verified_method(task, reading("BONOBO", "BONOBO", settings=[
+        ("BONOBO.bonobo_confidence", phrase, "0.05"),
+        ("BONOBO.delta", "delta at 0.4", "0.4"),
+    ], ask=task))
+    setting = next(s for s in method["settings"] if s["name"] == "BONOBO.sparsify")
+    conditions = conditions_for("BONOBO")
+    assert methods.run_setting_value(conditions.settings["sparsify"], conditions, setting) is expected
+
+
+def test_j17_keep_is_valid_and_bound_to_true():
+    quote = "keep the normalization by each patient's mutation burden"
+    conditions = conditions_for("SAMBAR")
+    setting = {"name": "SAMBAR.norm_patient", "quote": quote, "value": "keep"}
+    assert setting_issue(conditions, StatedSetting(setting["name"], quote, "keep")) is None
+    assert methods.run_setting_value(conditions.settings["norm_patient"], conditions, setting) is True
+
+
+def test_unparsed_explicit_value_is_unresolved_and_cannot_bind_a_default():
+    conditions = conditions_for("SAMBAR")
+    setting = {"name": "SAMBAR.norm_patient", "quote": "normalization is sparse-ish", "value": "sparse-ish"}
+    assert setting_issue(conditions, StatedSetting(setting["name"], setting["quote"], setting["value"])) is None
+    unresolved = methods.unresolved_settings({"named": "SAMBAR", "settings": [setting]}, ["sambar.subtypes"])
+    assert unresolved and unresolved[0]["name"] == "SAMBAR.norm_patient"
+    assert unresolved[0]["quote"] == setting["quote"]
+    assert methods.run_setting_value(conditions.settings["norm_patient"], conditions, setting) is None
+    assert methods.stated_no_value(conditions.settings["norm_patient"], setting) is False
+
