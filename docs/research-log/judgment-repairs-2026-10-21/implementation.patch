+"""An analysis and its settings or file destinations have one capability verdict.
+
+Public seam: build_capability_check, with actual frozen model readings. No model calls.
+"""
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+import sys
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parents[1] / "scripts"))
+from netzoo_agent_core.contracts.capability_check import proposal_model
+from netzoo_agent_core.interpretation.capability_check import build_capability_check
+
+
+def _record(key):
+    return json.loads((Path(__file__).parent / "fixtures/judgment_repairs" / f"{key}.json").read_text())
+
+
+def _build(raw):
+    n = sum(name[1:].isdigit() for name in raw["proposal"])
+    return build_capability_check(raw["task"], proposal_model(n).model_validate(raw["proposal"]))
+
+
+def test_anaphoric_setup_question_cannot_bypass_the_analysis_setting():
+    raw = _record("H18")
+    original = copy.deepcopy(raw)
+    check, _ = _build(raw)
+    assert not any(row.status in ("available", "partial", "with_step") for row in check.results())
+    assert any("lambda_inter" in reason for row in check.results() for reason in row.limits)
+    assert not check.unchecked
+    assert raw == original
+
+
+def test_output_destinations_do_not_bypass_the_owning_analysis_size_limit():
+    raw = _record("L13")
+    check, _ = _build(raw)
+    assert [row.status for row in check.results()] == ["not_available"]
+    assert any("374,850,000" in reason for row in check.results() for reason in row.limits)
+    attached = [row for row in check.requirements if row.parent_quote]
+    assert len(attached) == 1 and "lioness_dragon/edges.tsv" in attached[0].quote
+    assert attached[0].parent_quote == check.results()[0].quote
+    assert not check.unchecked and check.full_gap
+
+
+def test_explicit_setting_link_limits_analysis_and_keeps_fact_evidence():
+    raw = _record("H18")
+    owner = "Run DRAGON on our 110 matched colorectal tumours."
+    child = "Set lambda_inter to 0.2 for this analysis."
+    raw["task"] = owner + " " + child
+    p = raw["proposal"]
+    p["conditions"]["settings"] = []
+    p["conditions"]["other_requirements"] = []
+    p["s1"]["asks"][0].update(quote=owner, settings=[], sample_count_quote="110")
+    p["s1"]["has"] = []
+    p["s2"]["asks"][0].update(
+        quote=child, requirement_role="analysis_modifier", parent_quote=owner,
+        settings=[dict(name="unregistered", quote="lambda_inter", value_quote="0.2")])
+    check, rejected = _build(raw)
+    assert [row.status for row in check.results()] == ["not_available"]
+    assert any("lambda_inter" in reason for row in check.results() for reason in row.limits)
+    fact = next(fact for fact in check.facts if fact.property == "setting"
+                and any(evidence.result == owner for evidence in fact.evidence))
+    assert fact.id in check.results()[0].fact_ids
+    assert any(evidence.result == owner for evidence in fact.evidence)
+    assert not check.unchecked
+    assert not any(row.get("reason") == "unverified_analysis_modifier_link" for row in rejected)
+
+
+@pytest.mark.parametrize("key", ["L17", "M18", "M20"])
+def test_concrete_unsupported_results_remain_results_even_when_asked_as_questions(key):
+    raw = _record(key)
+    check, _ = _build(raw)
+    assert check.results() and all(row.status == "not_available" for row in check.results())
+    assert not any(row.parent_quote for row in check.results())
+
+
+def test_an_independent_second_analysis_keeps_its_own_available_result():
+    raw = _record("H18")
+    text = "Separately, use DRAGON for a network of our 40 matched breast tumours."
+    raw["task"] += " " + text
+    p = raw["proposal"]
+    second = copy.deepcopy(p["s1"]["asks"][0])
+    second.update(quote=text, settings=[], sample_count=40, sample_count_quote="40 matched breast tumours")
+    p["s3"] = dict(role="asks", has=[], about_methods=[], asks=[second])
+    check, _ = _build(raw)
+    assert [(r.quote, r.status) for r in check.results()] == [
+        (p["s1"]["asks"][0]["quote"], "not_available"), (text, "available")]
+    assert not check.unchecked
+
+
+@pytest.mark.parametrize("parent", ["invented analysis", "Can you set it up that way?"])
+def test_unverified_or_self_referential_parent_cannot_dismiss_a_result(parent):
+    raw = _record("H18")
+    raw["proposal"]["s2"]["asks"][0].update(requirement_role="analysis_modifier", parent_quote=parent)
+    check, rejected = _build(raw)
+    assert len(check.results()) == 2
+    assert any(r["reason"] == "unverified_analysis_modifier_link" for r in rejected)
+
+
+def test_parent_link_cannot_discard_a_concrete_unsupported_question():
+    raw = _record("H18")
+    child = "Can you train a model to predict patient survival?"
+    raw["task"] = raw["task"].replace("Can you set it up that way?", child)
+    raw["proposal"]["s2"]["asks"][0].update(
+        quote=child, requirement_role="analysis_modifier",
+        parent_quote=raw["proposal"]["s1"]["asks"][0]["quote"],
+        delivered_by=[], not_by=["outcome_prediction"])
+    check, rejected = _build(raw)
+    assert any(r.quote == child and r.kind == "result" for r in check.requirements)
+    assert any(r["reason"] == "unverified_analysis_modifier_link" for r in rejected)
+
+
+def test_named_condor_command_is_not_reinterpreted_as_producing_its_panda_input():
+    raw = _record("H37")
+    check, _ = _build(raw)
+    assert len(check.results()) == 1
+    row = check.results()[0]
+    assert row.quote == "Launch CONDOR on panda_lung_edges.tsv, please."
+    assert row.status == "available" and row.method["named"] == "CONDOR"
+    assert row.delivered_by and all(key.startswith("condor.") for key in row.delivered_by)
+    assert not check.unchecked
+    assert any(fact.name == "CONDOR.prefix" for fact in check.facts)
+
+
+@pytest.mark.parametrize("command,role", [
+    ("We previously ran CONDOR on panda_lung_edges.tsv.", "background"),
+    ("Launch CONDOR to train a survival predictor.", "asks"),
+    ("Launch CONDOR or PANDA on panda_lung_edges.tsv.", "asks"),
+])
+def test_missing_ask_recovery_does_not_infer_a_new_goal_from_context_or_purpose(command, role):
+    raw = _record("H37")
+    raw["task"] = raw["task"].replace("Launch CONDOR on panda_lung_edges.tsv, please.", command)
+    raw["proposal"]["s1"]["role"] = role
+    check, _ = _build(raw)
+    assert not check.results()
+
+
+def test_recovered_named_command_still_obeys_verified_data_conditions():
+    raw = _record("H37")
+    condition = "Each profile is a single cell."
+    raw["task"] += " " + condition
+    p = raw["proposal"]
+    p["s4"] = dict(role="background", has=[condition], about_methods=[], asks=[])
+    p["conditions"].update(data_unit="single_cells", data_unit_quote=condition)
+    check, _ = _build(raw)
+    assert len(check.results()) == 1 and check.results()[0].status == "not_available"
+    assert check.results()[0].attrs["data_unit"] == "single_cells"
+    assert not check.unchecked
+
+
+def test_parameter_value_cannot_swallow_an_independent_result_clause():
+    raw = _record("H18")
+    owner = "Run SAMBAR on our 8 tumours."
+    child = "Set kmax to 6 and train a survival predictor for this analysis."
+    raw["task"] = owner + " " + child
+    p = raw["proposal"]
+    p.pop("conditions")
+    p["s1"]["has"] = []
+    p["s1"]["asks"][0].update(
+        quote=owner, delivered_by=["sambar.subtypes"], settings=[],
+        named_method="SAMBAR", named_method_quote="SAMBAR", sample_count=8, sample_count_quote="8",
+        omics_layers=0)
+    p["s2"]["asks"][0].update(
+        quote=child, requirement_role="analysis_modifier", parent_quote=owner,
+        delivered_by=["sambar.subtypes"], omics_layers=0,
+        settings=[dict(name="SAMBAR.kmax", quote="kmax", value_quote="6 and train a survival predictor")])
+    check, rejected = _build(raw)
+    assert any(row.kind == "result" and row.quote == child for row in check.requirements)
+    assert not any(row.parent_quote and row.quote == child for row in check.requirements)
+    assert any(row["reason"] == "unverified_analysis_modifier_link" for row in rejected)
+
+
+@pytest.mark.parametrize("assignment", ["lambda_inter=0.2", "lambda_inter = 0.2", "lambda_inter =0.2"])
+def test_parameter_assignments_with_equals_still_limit_the_owning_analysis(assignment):
+    raw = _record("H18")
+    owner = "Run DRAGON on our 110 matched colorectal tumours."
+    child = f"Set {assignment} for this analysis."
+    raw["task"] = owner + " " + child
+    p = raw["proposal"]
+    p.pop("conditions")
+    p["s1"]["has"] = []
+    p["s1"]["asks"][0].update(quote=owner, settings=[], sample_count_quote="110")
+    p["s2"]["asks"][0].update(
+        quote=child, requirement_role="analysis_modifier", parent_quote=owner,
+        settings=[dict(name="unregistered", quote="lambda_inter", value_quote="0.2")])
+    check, _ = _build(raw)
+    assert [row.status for row in check.results()] == ["not_available"]
+    assert any("lambda_inter" in reason for row in check.results() for reason in row.limits)
+    assert any(row.parent_quote == owner and row.quote == child for row in check.requirements)
+
+
+def test_recovered_command_preserves_a_source_owned_regulator_gene_input():
+    check, _ = _build(_record("H37"))
+    assert check.results()[0].attrs["input_network"] == "regulator_gene"
+    assert check.results()[0].attrs["command_recovered"] is True
+
+
+def test_recovered_condor_command_rejects_a_source_owned_gene_gene_input():
+    raw = _record("H37")
+    original = raw["task"].split(". ")[1] + "."
+    context = "We have a gene-gene co-expression network in the supplied edge table."
+    raw["task"] = raw["task"].replace(original, context)
+    raw["proposal"]["s2"]["has"] = ["gene-gene co-expression network"]
+    check, _ = _build(raw)
+    assert len(check.results()) == 1
+    assert check.results()[0].attrs["input_network"] == "gene_gene"
+    assert check.results()[0].status == "not_available"
+
+
+@pytest.mark.parametrize("context", [
+    "We previously had a gene-gene co-expression network.",
