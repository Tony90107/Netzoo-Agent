+        keys = [key for key in keys if key in sheet_entries()]
+        for setting in unresolved_settings(method, keys):
+            if task and _span(task, setting["quote"]) is None:
+                continue
+            key = (setting["name"], setting["quote"], setting["value"])
+            found.setdefault(key, setting)
+    return [FactQuestion(
+        question=f'For {s["workflow"]}, what value should {s["control"]} have? '
+                 f'I could not resolve "{s["value"] or s["quote"]}".',
+        user_quote=s["quote"], workflows=[s["workflow"]], depends_on=s["name"],
+        notes={"unresolved": s["reason"]}) for s in found.values()]
+
+
+def unchecked_fact_quotes(check, agent, task: str) -> list[str]:
+    """Only evidence-backed, still-unsettled doubts make a failed fact call necessary."""
+    if check is None or agent is None or agent.status not in ("failed", "blocked") or not agent.candidates:
+        return []
+    settled = [quote for quote, _ in judged_count_words(check)]
+    settled += [row.unknown_quote for row in check.needed_facts() if row.file_checked]
+    quotes = []
+    for quote in check.uncertain_quotes:
+        if task and _span(task, quote) is None:
+            continue
+        if any(quote.casefold() in words.casefold() or words.casefold() in quote.casefold()
+               for words in settled if words):
+            continue
+        quotes.append(quote)
+    return list(dict.fromkeys(quotes))
diff --git a/scripts/netzoo_agent_core/interpretation/deterministic_refusal.py b/scripts/netzoo_agent_core/interpretation/deterministic_refusal.py
new file mode 100644
index 00000000..a62bfe77
--- /dev/null
+++ b/scripts/netzoo_agent_core/interpretation/deterministic_refusal.py
@@ -0,0 +1,112 @@
+"""Refusal-only recovery of an explicit sample minimum from a fallback reading.
+
+The fallback provides candidate source locations, never a verdict or a credit.
+Only a directly named registered method and a definite count of samples are
+recomputed against the registry. Unsupported semantics, feature counts, settings,
+unknowns and incomplete coverage remain unconfirmed. This helper cannot approve.
+"""
+from __future__ import annotations
+
+import re
+
+from ..contracts.capability_check import CheckedRequirement
+from ..method_names import method_names, named_workflows, workflows_in
+from ..workflow_conditions import conditions_for, data_issue, stated_numbers
+from .count_words import side_by_side
+
+# These are neutral sample descriptors, not arbitrary intervening words that
+# could change what is counted ("two genes across nine samples", for example).
+_SAMPLE_QUOTE = re.compile(
+    r"(?:\d+|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|"
+    r"thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty)\s+"
+    r"(?:(?:independent|total|biological|bulk|expression|RNA-seq|patient|tumou?r|"
+    r"monozygotic|twin|paired|healthy|control|cancer)\s+){0,4}samples?", re.I)
+_UNSETTLED = re.compile(r"\b(?:not|no|maybe|either|or|unsure|uncertain|hypothetical|excluding)\b|"
+                        r"\b(?:don't|do not|can't|cannot)\b", re.I)
+_OPERATION = re.compile(r"\b(?:run|launch|execute|infer|compute|classify|predict|cluster|identify|"
+                        r"summarize|summarise|compare|estimate|produce|generate)\b", re.I)
+_SENTENCE_END = re.compile(r"[.!?](?=\s|$)|\n")
+
+
+def _exact(task: str, quote: str) -> tuple[int, int] | None:
+    """Recovery requires literal source text, rather than fuzzy quote matching."""
+    if not isinstance(quote, str) or not quote.strip():
+        return None
+    start = task.find(quote)
+    return (start, start + len(quote)) if start >= 0 else None
+
+
+def _sample_source(task: str, method: dict) -> tuple[int, str] | None:
+    count, quote = method.get('samples'), method.get('samples_quote', '')
+    if type(count) is not int or count < 0 or not _SAMPLE_QUOTE.fullmatch(quote):
+        return None
+    span = _exact(task, quote)
+    if span is None or set(stated_numbers(quote)) != {count}:
+        return None
+    boundaries = [0, *(match.end() for match in _SENTENCE_END.finditer(task)), len(task)]
+    start, end = next(((a, b) for a, b in zip(boundaries, boundaries[1:])
+                       if a <= span[0] < b), (0, 0))
+    sentence = task[start:end]
+    if (_UNSETTLED.search(sentence) or side_by_side(sentence, count)
+            or method.get('named') not in workflows_in(sentence)):
+        return None
+    source_counts = {number for match in _SAMPLE_QUOTE.finditer(sentence)
+                     for number in stated_numbers(match.group())}
+    if source_counts != {count}:
+        return None
+    return count, quote
+
+
+def verified_refusal(check, task: str) -> list[CheckedRequirement] | None:
+    """Return freshly proved minimum-sample failures, or no recovered judgment.
+
+    Every represented result must fail every alternative allowed by its exact
+    named method. Unknown/unchecked portions and an additional method or operation
+    rule out a whole-request refusal. Passing a size check returns None as well.
+    """
+    if check is None or not check.provisional or not task:
+        return None
+    if (check.unchecked or check.unknowns or check.unknown_domains or check.unknown_scopes
+            or check.uncertain_quotes or check.count_alternatives or check.fact_conflicts):
+        return None
+    results = check.results()
+    if not results or any(row.kind == 'about_methods' for row in check.requirements):
+        return None
+    # Additional operations whose semantics the failed reading might have missed
+    # are outside this deliberately narrow recovery boundary.
+    if len(_OPERATION.findall(task)) > 1:
+        return None
+    spans = [_exact(task, row.quote) for row in check.requirements]
+    if any(span is None for span in spans):
+        return None
+    boundaries = [0, *(match.end() for match in _SENTENCE_END.finditer(task)), len(task)]
+    if any(task[a:b].strip() and not any(s < b and a < e for s, e in spans)
+           for a, b in zip(boundaries, boundaries[1:])):
+        return None
+    recovered, named = [], set()
+    for row in results:
+        method = row.method
+        name = method.get('named')
+        quote = method.get('named_quote', '')
+        if (name not in method_names() or _exact(task, quote) is None or workflows_in(quote) != [name]
+                or row.unknown_quote or row.depends_on or row.outcomes):
+            return None
+        sample = _sample_source(task, method)
+        workflows = named_workflows(name)
+        if sample is None or not workflows:
+            return None
+        count, sample_quote = sample
+        limits = []
+        for workflow in sorted(workflows):
+            conditions = conditions_for(workflow)
+            if conditions is None or (issue := data_issue(conditions, count, None)) is None:
+                return None
+            limits.append(issue)
+        named.add(name)
+        recovered.append(CheckedRequirement(
+            quote=row.quote, kind='result', status='not_available', by_code=True,
+            method={'named': name, 'named_quote': quote, 'samples': count, 'samples_quote': sample_quote},
+            limits=limits))
+    if set(workflows_in(task)) != named:
+        return None
+    return recovered
diff --git a/scripts/netzoo_agent_core/interpretation/goal_evidence.py b/scripts/netzoo_agent_core/interpretation/goal_evidence.py
new file mode 100644
index 00000000..81629a20
--- /dev/null
+++ b/scripts/netzoo_agent_core/interpretation/goal_evidence.py
@@ -0,0 +1,90 @@
+"""Relate a method goal to its analysis, separately from input provenance."""
+from __future__ import annotations
+
+import re
+
+from workflow_registry import OUTPUT_CAPABILITIES
+
+from ..method_names import registered_workflows, workflows_in
+
+
+def explicit_method_reference(words: str, method: str) -> bool:
+    """An operation/question targets this method; mentioning an input's producer does not."""
+    name = re.escape(method)
+    return bool(re.search(
+        rf"\b(?:(?:run|launch|start|execute|use|apply|kick off)\s+(?:the\s+)?{name}\b|"
+        rf"(?:can|could|does|will|should)\s+{name}\b)", words, re.I))
+
+
+def stated_goal_method(check) -> str:
+    """A verified, explicitly targeted method on a result is goal evidence even if its goal quote is shorter."""
+    known = registered_workflows()
+    for row in check.results():
+        name, quote = row.method.get("named", ""), row.method.get("named_quote", "")
+        if name in known and quote and quote.casefold() in row.quote.casefold() and explicit_method_reference(row.quote, name):
+            return name
+    return ""
+
+
+def source_granularity_choice(task: str) -> list[str]:
+    """A current method choice cannot settle an unstated aggregate/per-sample result.
+
+    This narrow witness reads explicit method alternatives from the source, even when
+    a reader credits both workflows or omits the choice. It does not infer an output
+    from input provenance, historical names, or a choice with a stated output scale.
+    """
+    from .request_integrity import _scoped_clauses, granularity_left_open, granularity_mentions
+
+    task = task.rsplit("User follow-up:", 1)[-1]
+    scales = {item.granularity for item in granularity_mentions(task)}
+    if len(scales) == 1 and not granularity_left_open(task):
+        return []
+    known = registered_workflows()
+    for sentence in re.split(r"[。！？!?;；\n]|\.(?:\s|$)", task):
+        for clause, scope in _scoped_clauses(sentence):
+            names = [name for name in workflows_in(clause) if name in known]
+            if scope != "current" or len(names) < 2 or not re.search(r"\bor\b", clause, re.I):
+                continue
+            prefix = clause[:clause.find(names[0])]
+            commanded = explicit_method_reference(clause, names[0]) and not re.search(
+                r"\b(?:not|never|don't|without)\b", prefix, re.I)
+            delegated = not prefix.strip() and re.search(r"\b(?:your call|you (?:choose|decide)|whichever)\b", sentence, re.I)
+            if not (commanded or delegated):
+                continue
+            signatures = [OUTPUT_CAPABILITIES[known[name]] for name in names]
+            if len({item.artifact_type for item in signatures}) == 1 and len({
+                    item.granularities for item in signatures}) > 1:
+                return names
+    return []
+
+
+def method_choice(check, decision=None, task: str = "") -> list[str]:
+    """Positive evidence of an open choice between different results, not a generic unmatched-row escape."""
+    if check is None or check.unconfirmed():
+        return []
+    rows = check.results()
+    if any(row.not_by or row.violations or row.limits and row.method.get("named") != "unregistered" for row in rows):
+        return []
+    if not check.full_gap and not any(row.status == "not_available" for row in rows):
+        if choices := source_granularity_choice(task):
+            return choices
+    if check.goal != "purpose_only" and any(row.status in ("available", "with_step", "partial", "needs_fact") for row in rows):
+        return []  # a concrete result already read constrains the method choice
+    # An unmatched result is vague only when the independent outcome reading agrees that its artifact is unknown.
+    # Concrete off-menu outcomes (including L17, differential modularity and prediction) remain gaps.
+    outcomes = [hypothesis.outcome for hypothesis in decision.outcome_hypotheses] if decision is not None else []
+    unknown_result = bool(outcomes and all(outcome.artifact_type == "unknown" for outcome in outcomes))
+    if check.goal == "result_named" and not unknown_result:
+        return []
+    choices = [check.goal_quote, *check.uncertain_quotes,
+               *(row.method.get("named_quote", "") for row in rows)]
+    known = registered_workflows()
+    for quote in choices:
+        names = [name for name in workflows_in(quote) if name in known]
+        if len(names) < 2 or not re.search(r"\b(?:or|either|versus|vs)\b", quote, re.I):
+            continue
+        signatures = {(OUTPUT_CAPABILITIES[known[name]].artifact_type,
+                       OUTPUT_CAPABILITIES[known[name]].granularities) for name in names}
+        if len(signatures) > 1:
+            return names
+    return []
diff --git a/scripts/netzoo_agent_core/interpretation/input_role_evidence.py b/scripts/netzoo_agent_core/interpretation/input_role_evidence.py
new file mode 100644
index 00000000..c399d41a
--- /dev/null
+++ b/scripts/netzoo_agent_core/interpretation/input_role_evidence.py
@@ -0,0 +1,31 @@
+"""Source-backed node roles of an existing network, distinct from a desired output."""
+from __future__ import annotations
+
+import re
+
+from .request_integrity import _REGULATORY_ROLE_PAIR, _HISTORY, _UNCERTAIN, _NEGATED, _OUTPUT
+from .request_spans import _span
+from .sentence_ownership import request_sentences
+
+
+def source_network_kinds(task: str, quotes) -> set[str]:
+    kinds = set()
+    sentences = request_sentences(task)
+    for quote in quotes:
+        span = _span(task, quote)
+        if span is None:
+            continue
+        owner = next(((a, b) for a, b in sentences if a <= span[0] and span[1] <= b), None)
+        source = task[owner[0]:owner[1]] if owner else ""
+        if not source or any(pattern.search(source) for pattern in (_HISTORY, _UNCERTAIN, _OUTPUT)):
+            continue
+        if not re.search(r"\b(?:network|edges?|edge[- ]list|co[- ]?expression matrix)\b", quote, re.I):
+            continue
+        regulator = _REGULATORY_ROLE_PAIR.search(quote)
+        gene = re.search(r"\bgene[- ](?:to[- ])?gene\b|\bco[- ]?expression\s+(?:network|matrix)\b", quote, re.I)
+        # A later "IDs do not overlap" describes a compatible property, not an absent network.
+        if regulator and not _NEGATED.search(task[owner[0]:span[0] + regulator.end()]):
+            kinds.add("regulator_gene")
+        if gene and not _NEGATED.search(task[owner[0]:span[0] + gene.end()]):
+            kinds.add("gene_gene")
+    return kinds
diff --git a/scripts/netzoo_agent_core/interpretation/recovered_input_contract.py b/scripts/netzoo_agent_core/interpretation/recovered_input_contract.py
new file mode 100644
index 00000000..1ae1c338
--- /dev/null
+++ b/scripts/netzoo_agent_core/interpretation/recovered_input_contract.py
@@ -0,0 +1,55 @@
+"""A recovered method command still has to satisfy the ordinary input contract."""
+from __future__ import annotations
+
+from ..capability_sheet import entry, sheet_entries
+from ..routing.capability_compatibility import explicit_input_artifacts
+from ..routing.method_rejections import rejected_methods_for
+from .input_role_evidence import source_network_kinds
+
+
+def _context_network_kind(check, task):
+    """Only a source-verified current input description supplies a network's node roles."""
+    return source_network_kinds(task, [row.quote for row in check.requirements
+                                      if row.kind == "context" and not row.parent_quote])
+
+
+def enforce_recovered_input_contract(check, task: str, decision):
+    if check is None or not any(row.attrs.get("command_recovered") for row in check.results()):
+        return check
+    inputs = set(explicit_input_artifacts(task)) | set(decision.guidance_input_artifacts)
+    inputs.update(value for hypothesis in decision.outcome_hypotheses for value in hypothesis.outcome.input_artifacts
+                  if value != "unknown")
+    rows = []
+    network_kinds = _context_network_kind(check, task)
+    for row in check.requirements:
+        if row.kind != "result" or not row.attrs.get("command_recovered"):
+            rows.append(row)
+            continue
+        candidates = row.delivered_by or [key for key, item in sheet_entries().items()
+                                          if item.kind == "produces" and item.workflow == row.method.get("named")]
+        actions = [entry(key).action for key in candidates]
+        rejections = {item.action: item for item in [*decision.rejected_methods,
+                      *rejected_methods_for(task, sorted(inputs), actions=actions)]}
+        blocked = [key for key in candidates if entry(key).action in rejections]
+        if len(network_kinds) == 1:
+            kind = next(iter(network_kinds))
+            network_blocked = [key for key in candidates
+                               if entry(key).input_network not in (None, kind)]
+            if network_blocked:
+                row = row.model_copy(update={
+                    "attrs": {**row.attrs, "input_network": kind},
+                    "limits": [*row.limits, *(f'{entry(key).workflow} requires a '
+                                f'{entry(key).input_network} input network; the input description states {kind}'
+                                for key in network_blocked)]})
+                blocked = list(dict.fromkeys([*blocked, *network_blocked]))
+        if blocked:
+            kept = [key for key in row.delivered_by if key not in blocked]
+            reasons = [rejections[entry(key).action].reason for key in blocked if entry(key).action in rejections]
+            row = row.model_copy(update={"delivered_by": kept, "status": row.status if kept else "not_available",
+                                         "limits": list(dict.fromkeys([*row.limits, *reasons]))})
+        rows.append(row)
+    if rows == check.requirements:
+        return check
+    results = [row for row in rows if row.kind == "result"]
+    gap = bool(results and all(row.status == "not_available" for row in results) and not check.unchecked)
+    return check.model_copy(update={"requirements": rows, "full_gap": gap})
diff --git a/scripts/netzoo_agent_core/interpretation/request_ownership.py b/scripts/netzoo_agent_core/interpretation/request_ownership.py
new file mode 100644
index 00000000..5b6e2fbd
--- /dev/null
+++ b/scripts/netzoo_agent_core/interpretation/request_ownership.py
@@ -0,0 +1,256 @@
+"""Attach dependent clauses to an analysis before crediting independently available results.
+
+A model link is evidence to verify, never permission to erase a concrete result.
+Old recordings have no links; only closed anaphoric confirmations are recovered.
+"""
+from __future__ import annotations
+
+import re
+
+from ..capability_sheet import sheet_entries
+from ..contracts.capability_check import CheckedRequirement, _ask_model, reading_version
+from .discovery import _UNLABELED_PATH_RE
+from .method_conditions import with_request_method
+from .input_role_evidence import source_network_kinds
+from .request_spans import _span
+from .sentence_ownership import request_sentences
+from ..method_names import workflows_in
+
+_CONFIRMATION = re.compile(
+    r"(?:can|could|would|will) (?:you|we) (?:please )?"
+    r"(?:set (?:it|this|that) up|do (?:it|this|that)|run (?:it|this|that)|proceed)"
+    r"(?: (?:that|this) way| (?:like|as) (?:that|this|described|requested))?[?.!]*", re.I)
+
+# File-only grammar: every coordinated clause specifies where a result file goes.
+# No clause can contain a new analysis verb, a remote destination or a new result
+# type such as a predictor/dashboard. Unknown phrasing keeps its original verdict.
+_FILE_CLAUSE = re.compile(
+    r"(?:(?:please )?(?:save|write|store|put) )?"
+    r"(?:(?:the|a|an|per-sample|sample|cohort|aggregate|individual|each|all|regulatory|"
+    r"TF-gene|gene-gene|integrated|two-layer|and|network|edge) )*"
+    r"(?:outputs?|results?|files?|edges?|networks?|matri(?:x|ces)|tables?) "
+    r"(?:to|in|under|at|as) <path>[.!?]*", re.I)
+
+
+def _file_delivery(words):
+    if "://" in words or "@" in words or "www." in words.casefold():
+        return False
+    replaced, count = _UNLABELED_PATH_RE.subn("<path>", words)
+    return bool(count) and all(_FILE_CLAUSE.fullmatch(clause.strip())
+                              for clause in re.split(r"\s+and\s+|;\s*", replaced))
+
+
+def _setting_modifier(task, span, item):
+    """A linked parameter assignment, with no unaccounted result-producing words."""
+    if getattr(item, "requirement_role", "result") != "analysis_modifier":
+        return False
+    words = task[span[0]:span[1]]
+    settings = getattr(item, "settings", [])
+    if not settings:
+        return False
+    for setting in settings:
+        # The setting quote must name a parameter, not swallow a second result.
+        if not re.fullmatch(r"[A-Za-z_][\w.-]*", setting.quote):
+            return False
+        if setting.quote not in words or not setting.value_quote or setting.value_quote not in words:
+            return False
+        # A value can be a literal number or a single control/name token. It
+        # cannot absorb a second requested result before the clause check. Its
+        # actual range/type remains the workflow contract's decision, so an
+        # unsupported setting still blocks its owning analysis.
+        if not re.fullmatch(
+                r"(?:[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?|[A-Za-z_][\w.-]*)",
+                setting.value_quote):
+            return False
+        words = words.replace(setting.quote, "<setting>", 1).replace(setting.value_quote, "<value>", 1)
+    assignment = r"<setting>(?:\s+(?:to|at)\s+|\s*=\s*|\s+)<value>"
+    return bool(re.fullmatch(
+        rf"(?:please )?(?:set|keep|use) {assignment}"
+        rf"(?: (?:and|,) {assignment})*"
+        r"(?: for (?:this|that|the) (?:analysis|run|network))?[.!?]*", words.strip(), re.I))
+
+
+def _compatible(item, owners):
+    """A new capability or explicit near miss is a separate result, never an inferred modifier."""
+    if item.not_by:
+        return False
+    known = sheet_entries()
+    keys = {key for owner in owners for key in owner.delivered_by}
+    if not set(item.delivered_by) <= keys:
+        return False
+    named = getattr(item, "named_method", "none")
+    workflows = {known[k].workflow for k in keys if k in known}
+    return named == "none" or named in workflows
+
+
+def _configuration_modifier(task, span, item):
+    """Source-covered control instructions may modify an analysis; they cannot hide another result."""
+    if getattr(item, "requirement_role", "result") != "analysis_modifier" or not item.settings:
+        return False
+    words = task[span[0]:span[1]]
+    for setting in sorted(item.settings, key=lambda setting: len(setting.quote), reverse=True):
+        control = setting.name.split(".")[-1]
+        quote = setting.quote
+        literal = re.fullmatch(rf"{re.escape(control)}\s+[-+]?(?:\d+(?:\.\d+)?|\.\d+)", quote)
+        retained = control == "norm_patient" and re.fullmatch(
+            r"keep (?:the )?normalization(?: by each patient's mutation burden)?", quote, re.I)
+        if quote not in words or not (literal or retained):
+            return False
+        words = words.replace(quote, "<setting>", 1)
+    return bool(re.fullmatch(r"(?:try|set|keep|use) <setting>(?:(?: up to|,? and|,) <setting>)*[.!?]*",
+                             words.strip(), re.I))
+
+
+def attach_requests(task, asks):
+    """Return independent asks, attached (span, owner, readings), and rejected model links.
+
+    No nearest-neighbour guessing with several independent analyses. Explicit links
+    must resolve to one exact quoted ask and a verifiable modifier form. Cycles and
+    self-links are rejected, leaving the original ask and its constraints intact.
+    """
+    kept = dict(asks)
+    attachments, rejected = [], []
+    for span, items in sorted(asks.items()):
+        words = task[span[0]:span[1]].strip()
+        if not (_CONFIRMATION.fullmatch(words) or _file_delivery(words)
+                or all(_setting_modifier(task, span, item) or _configuration_modifier(task, span, item) for item in items)):
+            continue
+        explicit = {getattr(item, "parent_quote", "") for item in items
+                    if getattr(item, "requirement_role", "result") == "analysis_modifier"}
+        candidates = [other for other in kept if other[1] <= span[0]]
+        if explicit:
+            targets = {_span(task, quote) for quote in explicit if quote.strip()}
+            candidates = [other for other in candidates if other in targets] if len(targets) == 1 else []
+        if len(candidates) == 1 and all(_compatible(item, kept[candidates[0]]) for item in items):
+            owner = candidates[0]
+            attachments.append((span, owner, items))
+            kept.pop(span)
+    linked = {span for span, _, _ in attachments}
+    for span, items in asks.items():
+        if span not in linked and any(getattr(item, "requirement_role", "result") == "analysis_modifier"
+                                      for item in items):
+            rejected.append({"quote": task[span[0]:span[1]], "reason": "unverified_analysis_modifier_link"})
+    return kept, attachments, rejected
+
+
+def read_analysis_methods(record, result, span, items, attachments):
+    """Compile one analysis's own and linked methods through the same fact boundary."""
+    methods = [record.read_method(item, "result", result) for item in items]
+    for _child, owner, attached in attachments:
+        if owner == span:
+            for item in attached:
+                given = record.read_method(item, "result", result)
+                methods = [with_request_method(method, given) for method in methods]
+    return methods
+
+
+def attachment_requirements(task, attachments):
+    """Keep linked clauses visible without granting them independent capability credits."""
+    return [CheckedRequirement(quote=task[child[0]:child[1]], kind="context", status="not_checked",
+                               parent_quote=task[owner[0]:owner[1]]) for child, owner, _items in attachments]
+
+
+def result_attrs(items, typed_names):
+    """Preserve typed attributes and trusted command recovery provenance for the result row."""
+    attrs = {key: getattr(items[0], key) for key in typed_names if hasattr(items[0], key)}
+    if any(getattr(item, "_command_recovered", False) for item in items):
+        attrs["command_recovered"] = True
+    return attrs
+
+
+def _input_only_command(words, root, sentence, method):
+    """Recover an omitted command only when all its remaining content names inputs or settings.
+
+    Resource quotes need a source noun witness; the reader's background label alone
+    cannot erase a requested predictor or causal result. Any unaccounted substantive
+    words keep the command outside this deliberately closed recovery grammar.
+    """
+    from ..routing.capability_compatibility import explicit_input_artifacts
+    from .setting_evidence import _ASSIGN
+
+    start = root.match(words)
+    if start is None:
+        return False
+    remaining = words[start.end():]
+    resources = r"\b(?:somatic mutation calls|gene[- ]length table|cancer[- ]gene list|pathway GMT)\b"
+    output = r"\b(?:causal|survival|predict\w*|classif\w*|outputs?|results?|dashboards?)\b"
+    found = False
+    for quote in sorted(sentence.has, key=len, reverse=True):
+        if (quote in remaining and not re.search(output, quote, re.I)
+                and (explicit_input_artifacts(quote) or re.search(resources, quote, re.I))):
+            remaining = remaining.replace(quote, " <input> ", 1)
+            found = True
+    for setting in method.get("settings", []):
+        if _ASSIGN.fullmatch(setting["quote"]) and setting["quote"] in remaining:
+            remaining = remaining.replace(setting["quote"], " <setting> ", 1)
+    return found and bool(re.fullmatch(
+        r"(?:(?:for|on|using|with|and|so|turn|please)\b|<input>|<setting>|[,\s.!?])+", remaining, re.I))
+
+
+def recover_named_command(task, proposal, sentences, method):
+    """An explicit registered command is an ask even when its sentence's asks list is empty.
+
+    Only a complete command optionally naming local input paths is recovered. A
+    purpose clause, result choice, or concrete output needs a semantic reading;
+    neither a filename nor a background mention supplies a requested method.
+    The recovered ask goes through the normal condition/fact/size checks.
+    """
+    conditions = getattr(proposal, "conditions", None)
+    if getattr(conditions, "goal", "") != "method_named" or not method.get("named"):
+        return sentences
+    named = method["named"]
+    keys = [key for key, entry in sheet_entries().items() if entry.kind == "produces" and entry.workflow == named]
+    if not keys:
+        return sentences
+    network_kinds = source_network_kinds(task, [quote for sentence in sentences if sentence.role == "background"
+                                               for quote in sentence.has])
+    if len(network_kinds) > 1:
+        return sentences
+    input_network = next(iter(network_kinds), "none")
+    path = r"[A-Za-z0-9_./~-]+\.(?:tsv|tab|txt|csv|gmt|npy)"
+    command = re.compile(
+        rf"(?:please\s+)?(?:launch|run|use|execute|start|kick off)\s+{re.escape(named)}"
+        rf"(?:\s+now)?(?:\s+(?:on|using|with)\s+{path}(?:\s*(?:and|,)\s*{path})*)?"
+        r"(?:,?\s+please)?[.!?]*", re.I)
+    spans = request_sentences(task)
+    found = list(sentences)
+    root_start = re.compile(rf"(?:please\s+)?(?:launch|run|use|execute|start|set up|kick off|queue)\s+"
+                            rf"(?:a\s+)?{re.escape(named)}\b", re.I)
+    new_result = re.compile(r"\b(?:to|and|then|so that)\s+(?:also\s+)?"
+                            r"(?:train|predict|prove|classify|generate|produce|create|build|infer|estimate|"
+                            r"compute|calculate|cluster|compare|summarize|plot)\b", re.I)
+    for index, sentence in enumerate(sentences):
+        if index >= len(spans):
+            continue
+        start, end = spans[index]
+        words = task[start:end].strip()
+        named_span = _span(task, method.get("named_quote", ""))
+        own = [item for item in sentence.asks if _span(task, item.quote) == (start, end)]
+        parent_of = any(getattr(item, "parent_quote", "").strip() == words for other in sentences for item in other.asks)
+        direct = bool(root_start.match(words) and not new_result.search(words))
+        input_only = direct and _input_only_command(words, root_start, sentence, method)
+        if not (command.fullmatch(words) or direct and (own or parent_of) or input_only):
+            continue
+        if named_span is None or not start <= named_span[0] < end:
+            continue
+        if (not own and not parent_of and not input_only and sentence.role not in ("asks", "mixed")) or any(item.not_by for item in own):
+            continue
+        names = workflows_in(words)
+        if len(names) > 1 and re.search(r"\bor\b", words, re.I):
+            continue
+        if any(item.delivered_by for item in own):
+            continue
+        fields = dict(
+            quote=words, delivered_by=keys, not_by=[], scale="unstated", omics_layers=0,
+            data_unit="not_stated", regulator_kinds=[], needs_sign=False, input_network=input_network,
+            group_membership="not_about_groups", time_model="not_dynamic", spatial="not_spatial",
+            asked_as="request", named_method=named, named_method_quote=method["named_quote"],
+            requirement_role="result", parent_quote="")
+        ask = (own[0].model_copy(update={**fields, **{key: getattr(own[0], key) for key in (
+            "data_unit", "omics_layers", "needs_sign", "regulator_kinds", "group_membership", "time_model", "spatial")}})
+               if own else _ask_model(version=reading_version(proposal)).model_validate(fields))
+        # Internal provenance only: a model cannot supply this field through
+        # the provider schema, and the resulting row can recheck its inputs.
+        ask = ask.model_copy(update={"_command_recovered": True})
+        found[index] = sentence.model_copy(update={"role": "asks", "asks": [ask, *(item for item in sentence.asks if item not in own)]})
+    return found
diff --git a/scripts/netzoo_agent_core/interpretation/setting_evidence.py b/scripts/netzoo_agent_core/interpretation/setting_evidence.py
new file mode 100644
index 00000000..587af8d9
--- /dev/null
+++ b/scripts/netzoo_agent_core/interpretation/setting_evidence.py
@@ -0,0 +1,66 @@
+"""Recover explicit parameter identifiers without substituting a different registered control."""
+from __future__ import annotations
+
+import re
+
+from ..method_names import UNREGISTERED, registered_workflows, workflows_in
+from ..workflow_conditions import conditions_for
+from .request_integrity import _scoped_clauses
+
+_VALUE = r"[-+]?(?:\d+(?:\.\d+)?|\.\d+)(?:[eE][-+]?\d+)?|true|false|on|off|yes|no"
+_ASSIGN = re.compile(rf"\b(?P<name>[A-Za-z][A-Za-z0-9_]*)"
+                    rf"(?:\s*(?:=|:)\s*|\s+(?:(?:of|at|to|is)\s+)?)"
+                    rf"(?P<value>{_VALUE})(?!\w|\.\d)", re.I)
+_LITERAL = re.compile(r"\blambda(?:\d+|_[A-Za-z0-9_]+)\b", re.I)
+
+
+def explicit_settings(task: str, method: dict, settings: list[dict], result_quote: str = "") -> list[dict]:
+    name = method.get("named", "")
+    if name not in registered_workflows():
+        return settings
+    conditions = conditions_for(name)
+    controls = conditions.settings
+    fixed = []
+    for setting in settings:
+        identifiers = set(_LITERAL.findall(setting["quote"]))
+        if len(identifiers) == 1:
+            identifier = next(iter(identifiers))
+            actual = f"{name}.{identifier}" if identifier in controls else UNREGISTERED
+            setting = {**setting, "name": actual}
+        fixed.append(setting)
+    # Only a single explicitly named analysis owns request-wide literal assignments.
+    if workflows_in(task) != [name]:
+        return fixed
+    if result_quote:
+        start = task.find(result_quote)
+        if start < 0:
+            return fixed
+        scope, offset = result_quote, start
+    else:
+        # Repeated mentions may be two analyses of the same method; a request-wide scan cannot choose an owner.
+        if len(re.findall(r"(?<![\w-])" + re.escape(name) + r"(?![\w-])", task)) != 1:
+            return fixed
+        scope, offset = task, 0
+    for match in _ASSIGN.finditer(scope):
+        absolute = offset + match.start()
+        follow_up = task.rfind("User follow-up:")
+        if follow_up >= 0 and absolute < follow_up:
+            continue
+        if any(clause in task and task.find(clause) <= absolute < task.find(clause) + len(clause)
+               for clause, context in _scoped_clauses(task) if context == "historical"):
+            continue
+        identifier = match["name"]
+        known = identifier in controls
+        prefix = scope[max(0, match.start() - 30):match.start()]
+        parameter = bool(_LITERAL.fullmatch(identifier) or re.search(r"\b(?:parameter|penalty|setting|control)\s+$", prefix, re.I))
+        if not known and not parameter:
+            continue
+        quote, value = match.group(), match["value"]
+        key = f"{name}.{identifier}" if known else UNREGISTERED
+        if any(item["name"] == key and item.get("value", "") == value
+               and item["span"][0] <= offset + match.start() and offset + match.end() <= item["span"][1] for item in fixed):
+            continue
+        fixed.append({"name": key, "quote": quote, "value": value,
+                      "span": [offset + match.start(), offset + match.end()], "at": offset + match.start("value"),
+                      "source": "explicit_parameter_identifier"})
+    return fixed
