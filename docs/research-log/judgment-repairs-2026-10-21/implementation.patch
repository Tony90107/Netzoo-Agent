+"""Literal user uncertainty and resource absence, independent of model polarity labels."""
+from __future__ import annotations
+
+import re
+
+from .request_spans import _span
+
+_DOUBT = re.compile(r"\b(?:I|we)\s+(?:do not|don't|cannot|can't)\s+(?:know|remember|recall|tell)\b|"
+                    r"\b(?:I'm|we're|I am|we are)\s+(?:not sure|unsure|uncertain)\b|"
+                    r"\b(?:not sure|unsure|uncertain)\s+(?:whether|if|which|about)\b", re.I)
+_RESOURCE = {
+    "mutations": r"mutations?|mutation calls?|mutation matrix",
+    "expression": r"expression|RNA[- ]?seq|transcriptom",
+    "motif_prior": r"motifs?", "ppi": r"PPI|protein[- ]protein|protein interaction",
+    "mirna_list": r"miRNA|microRNA", "covariates": r"covariates?|design (?:matrix|table)",
+    "network": r"networks?|edge lists?",
+    "second_omics": r"(?:second|another|additional|other|extra)\s+(?:omics?|data|assay|measurement|layer)|"
+                    r"methylation|proteom|metabolo",
+}
+_UNAVAILABLE = re.compile(r"\b(?:don't|do not|doesn't|does not|cannot|can't|have not|haven't)\s+"
+                          r"(?:have|provide|supply|obtain|possess|got)\b|"
+                          r"\b(?:lack|lacking|without|missing|unavailable|absent)\b|\bnot available\b", re.I)
+
+
+def explicit_doubt(task: str, quote: str) -> bool:
+    span = _span(task, quote)
+    return span is not None and bool(_DOUBT.search(task[span[0]:span[1]]))
+
+
+def explicit_absence(task: str, quote: str, kind: str) -> bool:
+    span = _span(task, quote)
+    resource = _RESOURCE.get(kind)
+    if span is None or resource is None:
+        return False
+    # Stop at a prior clause boundary so "no expression, but mutations" keeps the mutation input.
+    if not re.search(resource, quote, re.I):
+        return False
+    prefix = re.split(r"[,;\n]|\bbut\b", task[max(0, span[0] - 60):span[0]], flags=re.I)[-1]
+    words = prefix + task[span[0]:span[1]]
+    return bool(_UNAVAILABLE.search(words) or re.search(rf"\bno\s+(?:\w+\s+){{0,3}}(?:{resource})", words, re.I))
