+                                                      if row.kind == 'result' or 'twins_expr.tsv' not in row.quote]})
+    assert verified_refusal(check, task) is None
+
+
+def test_a_truncated_compound_count_is_not_an_exact_two_sample_witness(h11):
+    from netzoo_agent_core.interpretation.deterministic_refusal import verified_refusal
+
+    task, check = h11
