diff --git a/tests/test_deterministic_refusal.py b/tests/test_deterministic_refusal.py
new file mode 100644
index 00000000..be6a9192
--- /dev/null
+++ b/tests/test_deterministic_refusal.py
@@ -0,0 +1,147 @@
+"""Fallback readings may recover only a refusal independently proved by source facts."""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parents[1] / 'scripts'))
+
+from netzoo_agent_core.contracts.capability_check import CapabilityCheck, CheckedRequirement
+
+
+@pytest.fixture
+def h11():
+    case = json.loads((Path(__file__).parent / 'fixtures/judgment_repairs/goal_input_cases.json').read_text())['H11']
+    return case['task'], CapabilityCheck.model_validate(case['decision']['capability_check'])
+
+
+def changed(check, **method):
+    rows = [row.model_copy(update={'method': {**row.method, **method}}) if row.kind == 'result' else row
+            for row in check.requirements]
+    return check.model_copy(update={'requirements': rows})
+
+
+def test_h11_recovers_only_registry_generated_minimum_sample_refusal(h11):
+    from netzoo_agent_core.interpretation.deterministic_refusal import verified_refusal
+
+    task, check = h11
+    before = check.model_dump()
+    # Existing fallback verdict text and credits are not evidence for this result.
+    check = check.model_copy(update={'requirements': [row.model_copy(update={'limits': ['invented reason']})
+                             if row.kind == 'result' else row for row in check.requirements]})
+    (row,) = verified_refusal(check, task)
+    assert row.by_code and row.status == 'not_available' and row.delivered_by == []
+    assert row.limits == ['LIONESS-PANDA needs at least 3 samples; the request has 2']
+    assert row.method['samples_quote'] == 'two monozygotic twin samples'
+    assert check.provisional and before['provisional']
+
+
+def test_three_samples_returns_no_refusal_and_never_approves_a_fallback(h11):
+    from netzoo_agent_core.interpretation.deterministic_refusal import verified_refusal
+
+    task, check = h11
+    task = task.replace('two', 'three')
+    check = changed(check, samples=3, samples_quote='three monozygotic twin samples')
+    check = check.model_copy(update={'requirements': [row.model_copy(update={'quote': row.quote.replace('two', 'three')})
+                                                      for row in check.requirements]})
+    assert verified_refusal(check, task) is None
+    assert check.provisional
+
+
+@pytest.mark.parametrize('method', [
+    {'samples': 1}, {'samples_quote': 'two unrelated samples'}, {'samples_quote': 'two columns'},
+    {'named': 'BONOBO'}, {'named_quote': 'PANDA'}, {'named': 'TIGER', 'named_quote': 'TIGER'},
+])
+def test_hallucinated_count_method_or_quote_cannot_prove_a_refusal(h11, method):
+    from netzoo_agent_core.interpretation.deterministic_refusal import verified_refusal
+
+    task, check = h11
+    assert verified_refusal(changed(check, **method), task) is None
+
+
+def test_an_independently_available_result_keeps_the_whole_request_unconfirmed(h11):
+    from netzoo_agent_core.interpretation.deterministic_refusal import verified_refusal
+
+    task, check = h11
+    task += ' Also run BONOBO on nine samples.'
+    second = CheckedRequirement(quote='Also run BONOBO on nine samples', kind='result', status='available',
+                                delivered_by=['bonobo.per_sample_networks'],
+                                method={'named': 'BONOBO', 'named_quote': 'BONOBO',
+                                        'samples': 9, 'samples_quote': 'nine samples'})
+    check = check.model_copy(update={'requirements': [*check.requirements, second]})
+    assert verified_refusal(check, task) is None
+
+
+@pytest.mark.parametrize('extra', [
+    {'unchecked': ['another result']}, {'uncertain_quotes': ['maybe two samples']},
+    {'unknowns': [['sample_count', 'maybe two samples']]}, {'count_alternatives': [{'values': [2, 9]}]},
+])
+def test_missing_or_uncertain_coverage_cannot_prove_whole_request_refusal(h11, extra):
+    from netzoo_agent_core.interpretation.deterministic_refusal import verified_refusal
+
+    task, check = h11
+    assert verified_refusal(check.model_copy(update=extra), task) is None
+
+
+def test_an_unknown_method_never_becomes_a_known_sample_limit(h11):
+    from netzoo_agent_core.interpretation.deterministic_refusal import verified_refusal
+
+    task, check = h11
+    task = task.replace('LIONESS-PANDA', 'TIGER')
+    assert verified_refusal(changed(check, named='TIGER', named_quote='TIGER'), task) is None
+
+
+def test_a_negated_or_alternative_count_is_not_a_confirmed_count(h11):
+    from netzoo_agent_core.interpretation.deterministic_refusal import verified_refusal
+
+    task, check = h11
+    for replacement in ('not two monozygotic twin samples', 'two or ten monozygotic twin samples'):
+        altered = task.replace('two monozygotic twin samples', replacement)
+        assert verified_refusal(check, altered) is None
+
+
+def test_a_quote_containing_a_feature_count_is_not_a_sample_count(h11):
+    from netzoo_agent_core.interpretation.deterministic_refusal import verified_refusal
+
+    task, check = h11
+    altered = task.replace('two monozygotic twin samples', 'two genes across nine samples')
+    assert verified_refusal(changed(check, samples_quote='two genes across nine samples'), altered) is None
+
+
+def test_an_extra_unread_request_sentence_prevents_a_whole_request_refusal(h11):
+    from netzoo_agent_core.interpretation.deterministic_refusal import verified_refusal
+
+    task, check = h11
+    assert verified_refusal(check, task + ' Also list biological findings.') is None
+
+
+def test_a_named_alternative_unread_by_the_fallback_prevents_recovery(h11):
+    from netzoo_agent_core.interpretation.deterministic_refusal import verified_refusal
+
+    task, check = h11
+    # Keep all candidate quotes literal; the raw request now names an alternative.
+    task = task.replace('LIONESS-PANDA:', 'LIONESS-PANDA or TIGER:')
+    assert verified_refusal(check, task) is None
+
+
+def test_other_sample_counts_in_the_same_source_sentence_are_not_shared(h11):
