+def test_overlapping_groups_dynamics_and_spatial_neighbours_rule_every_entry_out():
+    """Log 402: heldout7 ON5 and heldout8 QN5/QN8/QN10 were credited to CONDOR, LIONESS-PUMA, LIONESS-PANDA."""
+    from netzoo_agent_core.interpretation.capability_check import second_opinion_pairs
+
+    task = "We want communities of our TF-gene network where one gene can belong to several communities."
+    quote = "communities of our TF-gene network where one gene can belong to several communities"
+
+    def check(**form):
+        proposal = proposal_model(1).model_validate({"s1": {"role": "asks", "has": [], "about_methods": [], "asks": [
+            {"quote": quote, "delivered_by": ["condor.communities"], "not_by": [], "scale": "unstated",
+             "omics_layers": 0, "data_unit": "not_stated", "regulator_kinds": [], "needs_sign": False,
+             "input_network": "regulator_gene", **{**FORMS, **form}}]}})
+        return build_capability_check(task, proposal)[0]
+
+    assert check().results()[0].status == "available"
+    for form in ({"group_membership": "several_groups"}, {"time_model": "dynamic"}, {"spatial": "uses_neighbors"}):
+        gapped = check(**form)
+        assert gapped.full_gap and gapped.results()[0].delivered_by == []
+        assert second_opinion_pairs(gapped, ["run_condor"]) == []  # nothing left to ask about
+    assert check(group_membership="one_group").results()[0].status == "available"
+
+
+def test_the_sheet_fails_closed_on_an_unknown_result_form(tmp_path, monkeypatch):
+    import netzoo_agent_core.capability_sheet as sheet
+
+    text = sheet.SHEET_PATH.read_text(encoding="utf-8").replace("spatial: [not_spatial]", "spatial: [anywhere]")
+    path = tmp_path / "sheet.yaml"
+    path.write_text(text, encoding="utf-8")
+    monkeypatch.setattr(sheet, "SHEET_PATH", path)
+    sheet.result_forms.cache_clear()
+    try:
+        with pytest.raises(ValueError, match="result_forms"):
+            sheet.result_forms()
+    finally:
+        sheet.result_forms.cache_clear()
