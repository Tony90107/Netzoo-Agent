@@ -0,0 +1,361 @@
+# NetZoo capability sheet (Logs 385-387). Reviewed with the user from draft 1 (2026-10-08);
+# review notes: docs/capability-sheet/審閱說明.zh-TW.md. Loaded by
+# netzoo_agent_core/capability_sheet.py, which fails closed on a malformed entry.
+#
+# - CLOSED WORLD ON `produces`. A requested result is supported only when a
+#   `produces` entry delivers it. Nothing is ever decided from `near_misses`;
+#   they let the reply say precisely why a tempting workflow does not give the
+#   result, so an incomplete near-miss list cannot create a false yes or no.
+# - `produces` lists what the executor writes (`files`, checked 2026-10-08),
+#   plus `with_step` results: the workflow gives the material and a named step
+#   the user runs outside NetZoo gives the result. A with_step result is
+#   supported, and the reply names the step.
+# - Every entry carries `source`: [EXEC] the executor code that writes it,
+#   [REG] a registry sentence checked in an earlier Log, or the paper.
+# - `see: <id>` copies the referenced entry's text; the entry keeps its own id.
+# - Every produces entry has `granularity` (aggregate, sample_specific or both); a
+#   multi-omic entry has `layers`, the most omics layers it models jointly (Log 388).
+
+registry_wide_not_produced:
+  # Already live as UNSUPPORTED_CLAIMS; repeated so the sheet is complete.
+  # `claim`: shown only when the study-purpose reader verified that claim (its cue-word witnesses).
+  - id: causal_proof
+    claim: causal
+    result_asked: Proof that one thing causes another (causal drivers, causal direction of an edge, ruling out confounding).
+    why_not: Every registered workflow estimates associations or model coefficients from observational data.
+    source: "[REG] UNSUPPORTED_CLAIMS['causal']"
+  - id: outcome_prediction
+    claim: prediction
+    result_asked: A trained model that predicts an outcome, a future state or a perturbation effect, with its accuracy.
+    why_not: No registered workflow fits a predictive or generative model; per-sample results can only be features for one built elsewhere.
+    source: "[REG] UNSUPPORTED_CLAIMS['prediction'] (wording widened from 'for new samples' to future states and perturbations: Log 385 U2/N2)"
+
+workflows:
+
+  PANDA:
+    action: run_panda
+    files: ["-o: TF-gene regulatory network (one file)"]
+    produces:
+      - id: panda.tf_gene_network
+        level: direct
+        result: One weighted TF-to-gene regulatory network across all the samples given.
+        granularity: aggregate
+        regulators: [tf]
+        inputs: [expression matrix (or adjusted co-expression), TF motif prior, PPI network]
+        reading: Edge weights are integrated support scores from message passing, not probabilities, not signed effects, not evidence of physical binding.
+        source: "Glass et al. 2013 PLoS ONE 8:e64832; [EXEC] docker/run-panda:4, scripts/run_panda_precomputed.py:79"
+      - id: panda.targeting_scores
+        granularity: aggregate
+        level: with_step
+        result: Each TF's out-degree and each gene's in-degree (targeting scores) in that network.
+        step: Sum edge weights per TF or per gene from the written network; NetZoo does not compute it.
+        source: "[REG] _AGGREGATE_TARGETING_NOTES; [EXEC] no degree computation in the agent (checked 2026-10-08)"
+      - id: panda.condition_comparison
+        granularity: aggregate
+        level: with_step
+        result: Which edges or TF targeting scores differ between conditions.
+        step: One run per condition on the same genes and priors, then compare; two aggregate networks give no per-sample spread for a test.
+        source: "[REG] CLAIM_SUPPORT run_panda group_difference"
+    near_misses:
+      - id: panda.no_complexes
+        result_asked: Which TFs physically form complexes, or complex stoichiometry.
+        why_not: The PPI network is an input of possible TF cooperation. PANDA refines a cooperativity matrix internally, but the executor does not save it, and it is not a measurement of physical complexes or stoichiometry.
+        source: "Glass et al. 2013; [EXEC] docker/run-panda:4 writes only the TF-gene network"
+      - id: panda.no_sign
+        result_asked: Whether a TF activates or represses a gene.
+        why_not: Edge weights are unsigned support scores.
+        instead_registered: run_giraffe
+        source: "[REG] GIRAFFE signed regulatory matrix"
+      - id: panda.no_motif_discovery
+        result_asked: Discover a TF's binding motif or binding sites.
+        why_not: The motif prior is an input; PANDA never searches sequence.
+        source: "Glass et al. 2013"
+      - id: panda.no_dynamics
+        result_asked: A model of how expression or regulation evolves over time.
+        why_not: One static network per set of samples; time points can only be compared as separate networks.
+        source: "Glass et al. 2013"
+
+  PUMA:
+    action: run_puma
+    files: ["-o: TF/miRNA-gene regulatory network (one file)"]
+    produces:
+      - id: puma.regulator_gene_network
+        level: direct
+        result: One weighted network of how TFs and miRNAs regulate genes, across all samples.
+        granularity: aggregate
+        regulators: [tf, mirna]
+        inputs: [expression matrix, TF motif prior, PPI network, miRNA-target prior and miRNA list]
+        reading: miRNA edges come from agreement between predicted targets and target-gene co-expression; the miRNA's own expression is not used.
+        source: "Kuijjer et al. 2020 Bioinformatics 36:4765; [EXEC] scripts/run_puma.py:115"
+      - id: puma.targeting_scores
+        granularity: aggregate
+        level: with_step
+        result: Each regulator's out-degree and each gene's in-degree.
+        step: Sum edge weights from the written network; NetZoo does not compute it.
+        source: "[REG] _AGGREGATE_TARGETING_NOTES"
+    near_misses:
+      - id: puma.no_lncrna_cerna
+        result_asked: lncRNA regulators, ceRNA or miRNA-sponge networks.
+        why_not: PUMA's non-TF regulators are miRNAs given by a target prior; it has no lncRNA layer and models no sponging.
+        source: "Kuijjer et al. 2020"
+      - id: puma.no_mirna_expression_use
+        result_asked: miRNA-gene edges estimated from miRNA expression (e.g. anti-correlation).
+        why_not: The miRNA's own expression is not an input.
+        source: "[REG] PUMA tie note; Kuijjer et al. 2020"
+
+  LIONESS-PANDA:
+    action: run_lioness_panda
+    files: ["-o: aggregate PANDA network", "-q: edge-by-sample table of single-sample networks"]
+    produces:
+      - id: lioness_panda.per_sample_networks
+        level: direct
+        result: One TF-gene network per sample, plus the aggregate network.
+        granularity: [aggregate, sample_specific]
+        regulators: [tf]
+        inputs: [expression matrix, TF motif prior, PPI network]
+        reading: Each sample's edges come from how leaving it out changes the cohort network; the networks are not statistically independent.
+        source: "Kuijjer et al. 2019 iScience 14:226; [EXEC] docker/run-lioness:28-30"
+      - id: lioness_panda.per_sample_targeting
+        granularity: sample_specific
+        level: with_step
+        result: A TF-by-sample (or gene-by-sample) targeting-score matrix.
+        step: Sum edge weights per TF per sample from the edge-by-sample table; NetZoo does not compute it.
+        source: "[REG] _LIONESS_TARGETING_NOTES"
+      - id: lioness_panda.association_tests
+        granularity: sample_specific
+        level: with_step
+        result: Edges or targeting scores tested between groups, paired time points, or against clinical variables (e.g. survival).
+        step: A statistical model outside NetZoo (e.g. limma, Cox), with multiple-testing correction; needs a clinical table keyed by sample ID.
+        source: "[REG] CLAIM_SUPPORT _per_sample_claims; Kuijjer et al. 2019 BMC Cancer 19:1003"
+    near_misses:
+      - id: lioness.no_single_cell
+        result_asked: Networks for individual cells.
+        why_not: Built for bulk samples; per-cell co-expression is dominated by dropout.
+        source: "[REG] OUTSIDE_STEPS single_cell"
+      - {id: lioness_panda.no_sign, see: panda.no_sign}
+      - {id: lioness_panda.no_complexes, see: panda.no_complexes}
+
+  LIONESS-PUMA:
+    action: run_lioness_puma
+    files: ["-o: aggregate PUMA network", "-q: per-sample table (header regulator, gene, prior_weight, samples)"]
+    produces:
+      - id: lioness_puma.per_sample_networks
+        level: direct
+        result: One TF/miRNA-gene network per sample, plus the aggregate network.
+        granularity: [aggregate, sample_specific]
+        regulators: [tf, mirna]
+        inputs: [expression matrix, TF motif prior, PPI network, miRNA-target prior and miRNA list]
+        source: "Kuijjer et al. 2019 iScience; Kuijjer et al. 2020; [EXEC] docker/run-lioness:50-53"
+      - {id: lioness_puma.per_sample_targeting, granularity: sample_specific, level: with_step, see: lioness_panda.per_sample_targeting}
+      - {id: lioness_puma.association_tests, granularity: sample_specific, level: with_step, see: lioness_panda.association_tests}
+    near_misses:
+      - {id: lioness_puma.no_single_cell, see: lioness.no_single_cell}
+      - {id: lioness_puma.no_lncrna_cerna, see: puma.no_lncrna_cerna}
+
+  OTTER:
+    action: run_otter
+    files: ["one file: TF-by-gene matrix, or source/target/weight edge list"]
+    produces:
+      - id: otter.tf_gene_network
+        level: direct
+        result: One weighted TF-to-gene regulatory network across all samples, fitted so that it agrees with the PPI network and gene co-expression.
+        granularity: aggregate
+        regulators: [tf]
+        inputs: [TF motif prior, PPI network, expression matrix or co-expression]
+        reading: Weights are on OTTER's own scale; compare only with OTTER networks built the same way. The optimization is non-convex.
+        source: "Weighill et al. 2021 AAAI 35:10263; [EXEC] data/otter.py:317-350"
+      - {id: otter.targeting_scores, granularity: aggregate, level: with_step, see: panda.targeting_scores}
+    near_misses:
+      - {id: otter.no_per_sample, result_asked: One network per sample., why_not: No per-sample OTTER is registered., instead_registered: run_lioness_panda, source: "[REG] CLAIM_SUPPORT run_otter"}
+      - {id: otter.no_global_optimum, result_asked: A convex or globally optimal solution., why_not: "Non-convex objective; netZooPy takes fixed gradient steps.", source: "[REG] OUTSIDE_STEPS convex_guarantee"}
+      - {id: otter.no_complexes, see: panda.no_complexes}
+      - {id: otter.no_sign, see: panda.no_sign}
+
+  GIRAFFE:
+    action: run_giraffe
+    files: ["<out>: TF-by-gene regulatory matrix", "<stem>.tfa<ext>: TF-by-sample activity matrix"]
+    produces:
+      - id: giraffe.signed_regulation
+        level: direct
+        result: A signed TF-to-gene regulatory matrix (positive activating, negative repressing), across all samples.
+        granularity: aggregate
+        regulators: [tf]
+        inputs: [expression matrix, TF motif prior, PPI network]
+        reading: Signs are fitted partial linear effects, not proof of direct binding or causality.
+        source: "Micheletti et al. 2026 bioRxiv (GIRAFFE); [EXEC] data/giraffe.py:298-319"
+      - id: giraffe.tf_activity
+        level: direct
+        result: Each TF's activity in each sample, estimated apart from its own mRNA level.
+        granularity: sample_specific
+        source: "Micheletti et al. 2026; [EXEC] data/giraffe.py:298-319 (.tfa file)"
+      - id: giraffe.activity_tests
+        granularity: sample_specific
+        level: with_step
+        result: TF activity tested between conditions or against clinical variables.
+        step: A statistical test outside NetZoo on the activity matrix, with multiple-testing correction.
+        source: "[REG] CLAIM_SUPPORT run_giraffe"
+    near_misses:
+      - id: giraffe.no_protein_level
+        result_asked: Measured TF protein abundance or binding occupancy.
+        why_not: Activity is inferred from expression and priors, not measured.
+        source: "Micheletti et al. 2026"
+      - {id: giraffe.no_per_sample_wiring, result_asked: A separate regulatory network for each sample., why_not: "The regulatory matrix is one for all samples; only activity is per sample.", instead_registered: run_lioness_panda, source: "[REG] _WIRING_READING_NOTE"}
+
+  DRAGON:
+    action: run_dragon
+    files: ["node-by-node partial-correlation matrix plus <stem>.pvalues and <stem>.adj_pvalues, or one edge list with partial_correlation, precision, p_value, adj_p_value"]
+    produces:
+      - id: dragon.two_layer_network
+        layers: 2
+        level: direct
+        result: One undirected partial-correlation network within and between two matched omics layers (any two, e.g. expression and methylation), across all samples.
+        granularity: aggregate
+        inputs: [omics layer 1, omics layer 2, same samples]
+        reading: Associations conditional on every other feature in both layers; adding or removing features changes them. Not directed, not causal.
+        source: "Shutta et al. 2023 NAR 51:e15; [EXEC] execution.py:792-800"
+      - id: dragon.edge_pvalues
+        layers: 2
+        granularity: aggregate
+        level: direct
+        result: A p-value and a Benjamini-Hochberg adjusted p-value for every edge (adjusted within each layer and across the layers), to filter edges by significance.
+        reading: Not estimated when the features far outnumber the samples; the run then says so and writes the network alone.
+        source: "Shutta et al. 2023; netZooPy dragon.estimate_p_values_dragon; [EXEC] execution.py run_dragon (Log 386: <stem>.pvalues / .adj_pvalues, or p_value / adj_p_value columns)"
+      - id: dragon.group_comparison
+        layers: 2
+        granularity: aggregate
+        level: with_step
+        result: Cross-layer edges compared between groups.
+        step: One network per group on the same features, then compare; no per-sample spread for a test.
+        source: "[REG] CLAIM_SUPPORT run_dragon"
+    near_misses:
+      - id: dragon.no_flux_or_pathway_activity
+        result_asked: Metabolic flux, pathway activity or quantities derived from a biochemical model.
+        why_not: DRAGON returns associations between measured features; it has no stoichiometric or kinetic model.
+        source: "Shutta et al. 2023"
+      - {id: dragon.no_more_layers, result_asked: Three or more omics layers in one model., why_not: Two layers only., source: "[REG] DRAGON notes (two layer-specific shrinkage parameters)"}
+
+  LIONESS-DRAGON:
+    action: run_lioness_dragon
+    files: ["output_file: aggregate partial-correlation matrix", "lioness_output: edge-by-sample table"]
+    produces:
+      - id: lioness_dragon.per_sample_networks
+        layers: 2
+        level: direct
+        result: One two-layer partial-correlation network per sample, plus the aggregate.
+        granularity: [aggregate, sample_specific]
+        inputs: [omics layer 1, omics layer 2, same samples]
+        reading: A sample's edges are relative to the cohort it was built from; not independent across samples.
+        source: "Kuijjer et al. 2019 iScience; Shutta et al. 2023; [EXEC] execution_lioness_dragon.py:104-107"
+      - id: lioness_dragon.association_tests
+        layers: 2
+        granularity: sample_specific
+        level: with_step
+        result: Per-sample edges compared between groups or individuals.
+        step: A statistical test outside NetZoo.
+        source: "[REG] CLAIM_SUPPORT run_lioness_dragon"
+    near_misses:
+      - id: lioness_dragon.no_pvalues
+        result_asked: Per-sample edge p-values.
+        why_not: LIONESS-DRAGON writes per-sample edge weights only; DRAGON's p-values are for the aggregate network.
+        source: "[EXEC] execution_lioness_dragon.py:104-107"
+      - {id: lioness_dragon.no_flux_or_pathway_activity, see: dragon.no_flux_or_pathway_activity}
+      - {id: lioness_dragon.no_single_cell, see: lioness.no_single_cell}
+
+  LIONESS-COEXPRESSION:
+    action: run_lioness_coexpression
+    files: ["-o: aggregate Pearson co-expression network", "-q: per-sample co-expression networks"]
+    produces:
+      - id: lioness_coexpression.per_sample_networks
+        level: direct
+        result: One gene-gene co-expression network per sample, plus the aggregate.
+        granularity: [aggregate, sample_specific]
+        inputs: [expression matrix]
+        source: "Kuijjer et al. 2019 iScience; [EXEC] docker/run-lioness:55-57"
+      - {id: lioness_coexpression.comparisons, granularity: sample_specific, level: with_step, result: Per-sample gene degree or edge weights compared across samples or groups., step: A test outside NetZoo., source: "[REG] DOWNSTREAM_ANALYSES run_lioness_coexpression"}
+    near_misses:
+      - id: coexpression.no_regulation
+        result_asked: Which regulator controls which gene, or edge direction.
+        why_not: Co-expression is undirected gene-gene similarity, with no regulator layer.
+        instead_registered: run_lioness_panda
+        source: "[REG] DOWNSTREAM_ANALYSES run_bonobo"
+      - {id: lioness_coexpression.no_single_cell, see: lioness.no_single_cell}
+
+  BONOBO:
+    action: run_bonobo
+    files: ["bonobo_<sample>: gene-by-gene co-expression per sample", "pvals_<sample> (only with sparsify + save_pvals)", "manifest.json"]
+    produces:
+      - id: bonobo.per_sample_networks
+        level: direct
+        result: One gene-gene co-expression network per sample, estimated with a Bayesian model; optionally per-edge p-values per sample.
+        granularity: sample_specific
+        inputs: [expression matrix]
+        source: "Saha et al. 2024 Genome Res 34:1397; [EXEC] execution_bonobo.py:188-195"
+    near_misses:
+      - {id: bonobo.no_regulation, see: coexpression.no_regulation}
+      - {id: bonobo.no_single_cell, see: lioness.no_single_cell}
+
+  COBRA:
+    action: run_cobra
+    files: ["components.npz", "summary.tsv", "adjusted_coexpression.tsv/.npz", "manifest.json"]
+    produces:
+      - id: cobra.covariate_components
+        level: direct
+        result: The part of each gene pair's co-expression associated with each covariate in a design matrix (e.g. group, batch), and a covariate-adjusted co-expression matrix.
+        granularity: aggregate
+        inputs: [expression matrix, design matrix]
+        reading: Component values can fall outside -1 to 1; they are contributions, not correlations.
+        source: "Micheletti et al. 2024 Bioinformatics 40:btae531; [EXEC] scripts/run_cobra.py:48-92"
+      - {id: cobra.adjusted_input_to_regulation, granularity: aggregate, level: with_step, result: A regulatory network built from batch-adjusted co-expression., step: "Pass adjusted_coexpression to PANDA, PUMA or OTTER (registered handoff) after identifier checks.", source: "[REG] DOWNSTREAM_ANALYSES run_cobra"}
+    near_misses:
+      - id: cobra.no_differential_expression
+        result_asked: Differentially expressed genes, fold changes or p-values per gene.
+        why_not: COBRA decomposes gene-pair co-expression; it does not test single genes' expression.
+        source: "Micheletti et al. 2024"
+      - id: cobra.no_pair_significance
+        result_asked: Which gene pairs differ significantly between groups.
+        why_not: Components are effect contributions; deciding significance is a separate analysis.
+        source: "[REG] CLAIM_SUPPORT run_cobra caveat"
+
+  CONDOR:
+    action: run_condor
+    files: ["<prefix>-edges.tsv", "<prefix>-reg_memb.tsv and -tar_memb.tsv: community memberships", "<prefix>-reg_qscores.tsv and -tar_qscores.tsv: core scores", "<prefix>-summary.txt (modularity)"]
+    produces:
+      - id: condor.communities
+        level: direct
+        result: Communities in one bipartite network, with regulator-side and gene-side memberships, by bipartite modularity.
+        granularity: aggregate
+        inputs: [a regulator-gene (source-target-weight) network]
+        source: "Platig et al. 2016 PLoS Comput Biol 12:e1005033; [EXEC] docker/run-condor:137-163"
+      - id: condor.core_scores
+        granularity: aggregate
+        level: direct
+        result: Each regulator's and gene's core score -- its share of its community's modularity -- to pick out each community's core nodes.
+        source: "Platig et al. 2016; [EXEC] docker/run-condor final_scores (Log 386: <prefix>-reg_qscores.tsv, -tar_qscores.tsv)"
+      - {id: condor.enrichment, granularity: aggregate, level: with_step, result: Pathway enrichment of each community's genes., step: A gene-set tool outside NetZoo., source: "[REG] DOWNSTREAM_ANALYSES run_condor"}
+    near_misses:
+      - {id: condor.no_two_network_comparison, result_asked: Differential module structure between two networks., why_not: One network at a time., source: "[REG] OUTSIDE_STEPS differential_modules (ALPACA)"}
+      - id: condor.no_variant_mapping
+        result_asked: Fine-mapping causal variants, or variant effects on binding.
+        why_not: CONDOR partitions a given network; it does not test or fine-map variants (its original eQTL use takes eQTL associations as input).
+        source: "Platig et al. 2016"
+
+  SAMBAR:
+    action: run_sambar
+    files: ["mt_out.csv: gene mutation scores", "pt_out.csv: pathway mutation scores", "clustergroups.csv and dist_matrix.csv (clustering on)", "manifest.json"]
+    produces:
+      - id: sambar.subtypes
+        level: direct
+        result: Patient subtypes from somatic mutations -- gene mutation scores summarized into pathway mutation scores, then hierarchical clustering of the patients on them -- with the scores, the cluster labels and the sample distance matrix.
+        granularity: aggregate
+        inputs: [mutation matrix, exon sizes, cancer genes, pathway sets]
+        source: "Kuijjer et al. 2018 Br J Cancer 118:1492; [EXEC] scripts/run_sambar.py:43-90"
+      - {id: sambar.clinical_comparison, granularity: aggregate, level: with_step, result: Subtypes compared with clinical variables such as survival., step: A test outside NetZoo with a clinical table keyed by sample ID., source: "[REG] DOWNSTREAM_ANALYSES run_sambar"}
+    near_misses:
+      - id: sambar.no_expression_subtypes
+        result_asked: Subtypes from expression, methylation or other non-mutation data.
+        why_not: SAMBAR's input is somatic mutations.
+        source: "Kuijjer et al. 2018"
+      - id: sambar.no_driver_calls
+        result_asked: Which mutations are drivers, or mutation calling.
+        why_not: SAMBAR summarizes given mutation calls; it does not call or rank driver mutations.
+        source: "Kuijjer et al. 2018"
