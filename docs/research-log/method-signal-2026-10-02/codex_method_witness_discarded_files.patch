@@ -110,6 +110,64 @@ def explicit_evidence_grounded(user_task: str, evidence: OutcomeEvidence) -> boo
     )
 
 
+# A quotation proves that words appeared, not that they request a particular
+# algorithm. These are the method-specific tags that can distinguish otherwise
+# identical aggregate TF-gene network outputs. Unstated method preferences must
+# remain a choice rather than turning an LLM gloss on the goal into authority.
+_METHOD_SIGNAL_WITNESSES = {
+    "message_passing": re.compile(
+        r"message[- ]?passing|iterative(?:ly)?\s+(?:message|information)\s+exchang"
+        r"|訊息傳遞|消息传递", re.I,
+    ),
+    "relaxed_graph_matching": re.compile(
+        r"graph[- ]?matching|projection[- ]?matching|(?:explicit\s+)?"
+        r"(?:objective|loss)\s+(?:function|term)|gradient\s+descent"
+        r"|圖匹配|图匹配|目標函數|目标函数|損失函數|损失函数", re.I,
+    ),
+    "tfa": re.compile(
+        r"(?:tf|transcription\s+factor)[- ]?activit(?:y|ies)|"
+        r"(?:tf|transcription\s+factor)\s+activity|轉錄因子活性|转录因子活性",
+        re.I,
+    ),
+    "biologically_informed_matrix_factorization": re.compile(
+        r"matrix\s+factori[sz]ation|factor(?:ize|ise)?\s+(?:gene\s+)?expression"
+        r"|矩陣分解|矩阵分解|因子分解", re.I,
+    ),
+    "linear_model_coefficients": re.compile(
+        r"linear\s+(?:expression\s+)?model|(?:linear|regression)\s+coefficients?"
+        r"|線性模型|线性模型|迴歸係數|回归系数", re.I,
+    ),
+    "signed_partial_regulatory_effects": re.compile(
+        r"signed\s+(?:partial\s+)?(?:regulatory\s+)?effects?|"
+        r"activat(?:ing|ion).{0,24}repress(?:ing|ion)|"
+        r"positive.{0,24}negative|正負調控|正负调控|活化.{0,12}抑制", re.I,
+    ),
+}
+
+
+def selection_tag_evidence_supported(
+    user_task: str, tag: str, text_span: str,
+) -> bool:
+    """Require a method-specific witness before a tag can break a workflow tie."""
+    if tag == "lioness_base_compatibility":
+        return bool(
+            re.search(r"\bLIONESS\b", user_task, re.I)
+            and re.search(r"\b(?:aggregate|cohort|base|first[- ]?stage)\b|整體|群體|基础|基礎", text_span, re.I)
+        )
+    if tag == "joint_grn_tfa_inference":
+        return bool(
+            _METHOD_SIGNAL_WITNESSES["tfa"].search(text_span)
+            and re.search(r"regulat|network|grn|調控|调控|網路|网络", text_span, re.I)
+        )
+    if tag == "tfa_covariate_regression":
+        return bool(
+            _METHOD_SIGNAL_WITNESSES["tfa"].search(text_span)
+            and re.search(r"covariate|regress|predictor|共變量|协变量|迴歸|回归", text_span, re.I)
+        )
+    witness = _METHOD_SIGNAL_WITNESSES.get(tag)
+    return witness is None or bool(witness.search(text_span))
+
+
 def grounded_selection_tags(
