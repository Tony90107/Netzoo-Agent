+
+def _quoted_partition_correction(user_task, outcome, evidence):
+    """A network partition the reading took for sample clusters (Log 296).
+
+    "The gene modules inside each patient's network" was read as
+    `sample_cluster_assignment`, whose only entity is the sample. The quote
+    names a partition of a network's nodes, which the ontology calls
+    `community_assignment` ("not patient subtype labels"). Only that quote,
+    in that reading's own evidence, moves the artifact; a request that groups
+    patients keeps its reading.
+    """
+    if outcome.artifact_type != "sample_cluster_assignment" or patient_clustering_goal(user_task):
+        return None
+    quotes = [
+        item for item in evidence
+        if item.dimension == "artifact_type" and item.value == "sample_cluster_assignment"
+        and item.source == "explicit" and item.text_span
+        and _PARTITION_QUOTE.search(item.text_span)
+        and explicit_evidence_grounded(user_task, item)
+    ]
+    if not quotes:
+        return None
+    candidate = _without_roles(outcome.model_copy(update={"artifact_type": "community_assignment"}))
+    if candidate is None or set(outcome_consistency_issues(candidate)) - {
+        "artifact_granularity:community_assignment"
+    }:
+        return None
+    moved = [
+        item.model_copy(update={
+            "value": "community_assignment",
+            "rationale": "The quote names a partition of a network, the ontology's community assignment.",
+        })
+        for item in quotes
+    ]
+    return candidate, [item for item in evidence if item not in quotes] + moved, quotes[0].text_span
 
 
