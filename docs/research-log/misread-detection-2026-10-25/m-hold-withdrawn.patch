index 00000000..72aba1b0
--- /dev/null
+++ b/scripts/netzoo_agent_core/graph/m_hold_call.py
@@ -0,0 +1,103 @@
+"""M-hold pilot (misread-detection PLAN-M-SHADOW.md; candidate only): the closed-menu read and the hold on the live
+path. Off by default: NETZOO_M_HOLD=1 turns it on; off, the turn is exactly the frozen system's.
+
+After `decide_core` (and the hybrid hooks), on the first turn of a task whose call acts, the request is read once more
+by the closed-menu reader -- the frozen code's `read_menu` and `read_focused`, as the h9 round read it -- and decided by
+`decide_menu`. When that call would ask, the turn is held and asks (`interpretation.m_hold`). Every read, held or not,
+is recorded in one `shadow.m_hold` event with the call the turn would have made.
+
+The read's tokens and cost are recorded in that event only, never in the turn's usage: a turn the pilot does not hold
+keeps the frozen system's budget state exactly (no later step sees a larger spend). The read is not preflighted
+against the turn budget either, so it never blocks or is blocked by the turn's own reads; its input is the fixed
+reader prompt and the request, and its output is capped at 8,000 tokens.
+"""
+
+from __future__ import annotations
+
+import os
+import time
+
+from ..interpretation.m_hold import held_core, triggers
+from .context import record_event
+
+__all__ = ["MENU_MODEL", "apply_m_hold", "first_turn"]
+
+MENU_MODEL = "openai/gpt-4o-mini"
+_LLM = None
+
+
+def _llm():
+    global _LLM
+    if _LLM is None:
+        from ..llm import build_llm, validate_router_model
+        _LLM = build_llm(validate_router_model(MENU_MODEL), 0.0, max_output_tokens=8000, timeout_seconds=150)
+    return _LLM
+
+
+def first_turn(state) -> bool:
+    """The task's first turn: one user message so far, and no round of this task asked yet."""
+    users = sum(1 for message in state.get("messages") or [] if getattr(message, "type", "") in ("human", "user"))
+    task = state.get("task_state") or {}
+    rounds = task.get("rounds", 0) if isinstance(task, dict) else getattr(task, "rounds", 0)
+    return users == 1 and not rounds
+
+
+def _spent(read) -> dict:
+    from ..llm import extract_provider_usage
+
+    found = extract_provider_usage(read.raw) if read.raw is not None else None
+    return {"input_tokens": (found or {}).get("input_tokens", 0), "output_tokens": (found or {}).get("output_tokens", 0),
+            "cost_micro_usd": (found or {}).get("cost_micro_usd"), "error": read.error, "seconds": read.seconds}
+
+
+def apply_m_hold(context, state, decision, core, user_task: str, usage, warnings):
+    """(core, usage, warnings): the held call when the closed-menu reading would ask; otherwise the call as it came."""
+    if os.environ.get("NETZOO_M_HOLD", "0") != "1":
+        return core, usage, warnings
+    first = first_turn(state)
+    if not triggers(core, first):
+        record_event(context, state, "shadow.m_hold", "classify",
+                     {"status": "not_triggered", "kind": core.kind, "basis": core.basis, "first_turn": first})
+        return core, usage, warnings
+    from ..interpretation.menu_decision import decide_menu
+    from ..interpretation.provider_fallback import _is_fatal_exception
+    from .menu_reading_call import read_focused, read_menu
+
+    started, calls, latest = time.monotonic_ns(), [], None
+    try:
+        llm = _llm()
+        read = read_menu(user_task, llm)
+        calls.append({"role": "m_hold_menu", **_spent(read)})
+        latest = read.reading
+        if latest.status != "failed":
+            focused, _candidates = read_focused(user_task, latest, llm)
+            if focused is not None:
+                calls.append({"role": "m_hold_focus", **_spent(focused)})
+                latest = focused.reading
+    except BaseException as error:
+        if _is_fatal_exception(error):
+            raise
+        record_event(context, state, "shadow.m_hold", "classify",
+                     {"status": "read_failed", "kind": core.kind, "basis": core.basis, "calls": calls,
+                      "error_type": type(error).__name__, "error_message": str(error)[:500]})
+        return core, usage, warnings
+    if latest is None or latest.status == "failed":
+        record_event(context, state, "shadow.m_hold", "classify",
+                     {"status": "read_failed", "kind": core.kind, "basis": core.basis, "calls": calls})
+        return core, usage, warnings
+    menu = decide_menu(latest, user_task)
+    held = held_core(core, decision, menu, user_task)
+    record_event(context, state, "shadow.m_hold", "classify", {
+        "status": "held" if held is not None else "agrees", "model": MENU_MODEL, "calls": calls,
+        "seconds": round((time.monotonic_ns() - started) / 1e9, 1),
+        "would_have": {"kind": core.kind, "basis": core.basis, "workflows": list(core.workflows),
+                       "partial": core.partial},
+        "menu": {"kind": menu.kind, "basis": menu.basis, "workflows": list(menu.workflows),
+                 "questions": [q.dimension for q in menu.questions]},
+        "held": None if held is None else {"kind": held.kind, "basis": held.basis,
+                                           "source": held.evidence["m_hold"]["source"],
+                                           "question": (held.facts[0].question if held.facts
+                                                        else held.clarify.question if held.clarify else ""),
+                                           "user_quote": held.facts[0].user_quote if held.facts else ""},
+        "reading": latest.model_dump(mode="json", exclude_defaults=True)})
+    return (held if held is not None else core), usage, warnings
diff --git a/scripts/netzoo_agent_core/interpretation/m_hold.py b/scripts/netzoo_agent_core/interpretation/m_hold.py
new file mode 100644
index 00000000..0929ab33
--- /dev/null
+++ b/scripts/netzoo_agent_core/interpretation/m_hold.py
@@ -0,0 +1,75 @@
+"""M-hold pilot (misread-detection PLAN-M-SHADOW.md, user-approved 2026-10-25; candidate only, off by default).
+
+When the turn's call would act (DO or DECLINE) but an independent closed-menu reading of the whole request would ask
+(its `decide_menu` call is ASK or CLARIFY), the two readings disagree, and on the h9 round that disagreement marked
+misread requests (RESULTS-H9.md). The pilot holds such a turn and asks, so the question and the user's second turn
+can be measured; the call the turn would have made is kept in the evidence (shadow), never lost.
+
+What is asked (PLAN-M-SHADOW.md, set after the six h9 flags, first tested on h10):
+1. the menu reading holds a doubt about a fact -- a question of kind `condition` (a condition, a file, a count or a
+   setting), whose words are verified in the request -- so that fact is asked, quoting the user's words;
+2. otherwise only the wanted result is open, so the result is asked (`_clarify_need`).
+The reply states nothing code cannot verify: no feasibility, no reason (`ask_facts`, `clarify_goal`).
+
+Pure code; the menu read and the hook are `graph.m_hold_call`.
+"""
+
+from __future__ import annotations
+
+from ..contracts.core_decision import CoreDecision, FactQuestion
+from .m_hold_names import FACT_BASIS, GOAL_BASIS, HOLD_OPENING
+
+__all__ = ["FACT_BASIS", "GOAL_BASIS", "HOLD_OPENING", "held_core", "triggers"]
+
+_ACTING = frozenset({"DO", "DECLINE"})
+_ASKING = frozenset({"ASK", "CLARIFY"})
+
+
+def triggers(core, first_turn: bool) -> bool:
+    """Whether the turn is one the pilot may hold: the first turn of a task, a call that acts, not a tool action."""
+    return first_turn and core.kind in _ACTING and core.basis != "tool"
+
+
+def _fact_question(menu_decision, task: str):
+    """The first `condition` question of the menu decision whose words are in the request, else None."""
+    from .menu_reader import quote_in
+
+    for question in menu_decision.questions:
+        if question.kind == "condition" and question.quote and quote_in(question.quote, task):
+            return question
+    return None
+
+
+def _fact_text(question) -> str:
+    from .menu_reply import _ASKED
+
+    dimension = question.dimension
+    if dimension.startswith("setting:"):
+        workflow, control = dimension.split(":", 1)[1].split(".", 1)
+        asked = f"Which value of {workflow}'s {control} applies?"
+    else:
+        asked = _ASKED.get(dimension, f"Which is right about the {dimension.replace('_', ' ')}?")
+    labels = [label for _value, label in question.options if label]
+    return f"{asked} ({' / '.join(labels)})" if labels else asked
+
+
+def held_core(core, decision, menu_decision, task: str) -> CoreDecision | None:
+    """The held call when the menu reading would ask, else None. `core` is the call the turn would have made; it is
+    kept whole in the evidence (`m_hold.would_have`)."""
+    if menu_decision is None or menu_decision.kind not in _ASKING:
+        return None
+    from .core_decision import _clarify_need
+    from .obligations import fact_key
+
+    shadow = {"would_have": core.model_dump(mode="json"), "menu_kind": menu_decision.kind,
+              "menu_basis": menu_decision.basis, "menu_questions": [q.dimension for q in menu_decision.questions]}
+    question = _fact_question(menu_decision, task)
+    if question is not None:
+        fact = FactQuestion(question=_fact_text(question), user_quote=question.quote,
+                            fact_key=fact_key("agent", question.dimension, task, question.quote))
+        evidence = {**core.evidence, "m_hold": {**shadow, "source": "fact", "dimension": question.dimension}}
+        return CoreDecision(kind="ASK", basis=FACT_BASIS, facts=[fact], evidence=evidence)
+    check = decision.capability_check
+    need = _clarify_need(decision, check, task=task)
+    evidence = {**core.evidence, "m_hold": {**shadow, "source": "result"}}
+    return CoreDecision(kind="CLARIFY", basis=GOAL_BASIS, clarify=need, evidence=evidence)
