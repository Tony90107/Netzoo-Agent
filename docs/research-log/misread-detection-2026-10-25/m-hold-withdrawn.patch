new file mode 100644
index 00000000..8d141b3f
--- /dev/null
+++ b/tests/test_m_hold.py
@@ -0,0 +1,199 @@
+"""M-hold pilot (misread-detection PLAN-M-SHADOW.md): the hold of a call the closed-menu reading would ask about
+(no model calls).
+
+Off unless NETZOO_M_HOLD=1; on, only the first turn of a task whose call acts is read, a condition doubt with its
+words in the request is asked as a fact, anything else asks the result, the reply says nothing it cannot verify, the
+call it would have made is kept, and the turn's usage is never touched.
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+sys.path.insert(0, str(Path(__file__).parents[1] / "scripts"))
+
+from netzoo_agent_core.contracts import LLMUsage, TaskDecision  # noqa: E402
+from netzoo_agent_core.contracts.core_decision import CoreDecision  # noqa: E402
+from netzoo_agent_core.contracts.menu_reading import MenuDecision, MenuReading, Question  # noqa: E402
+from netzoo_agent_core.graph import m_hold_call  # noqa: E402
+from netzoo_agent_core.interpretation.m_hold import (  # noqa: E402
+    FACT_BASIS, GOAL_BASIS, HOLD_OPENING, held_core, triggers)
+
+TASK = ("I want CONDOR communities from the network file my collaborator sent. I can't remember whether this file "
+        "is the TF-to-gene edge list from her PANDA run or the edge list from her DRAGON run.")
+DOUBT = "I can't remember whether this file is the TF-to-gene edge list from her PANDA run"
+
+
+def do(*workflows: str) -> CoreDecision:
+    return CoreDecision(kind="DO", basis="results_given", workflows=list(workflows), evidence={"rows": []})
+
+
+def decision() -> TaskDecision:
+    return TaskDecision(action="no_tool", in_scope=True, should_execute=False, reason="r", confidence=0.0)
+
+
+def menu(kind: str, *questions: Question) -> MenuDecision:
+    return MenuDecision(kind=kind, basis="intent", questions=list(questions))
+
+
+def condition(quote: str = DOUBT) -> Question:
+    return Question(item=0, dimension="input_network", kind="condition", quote=quote,
+                    options=[("regulator_gene", "regulators linked to genes"), ("gene_gene", "genes linked to genes")])
+
+
+def intent() -> Question:
+    return Question(item=0, dimension="artifact_group", kind="intent", options=[("communities", "communities")])
+
+
+def test_only_a_first_turn_that_acts_is_held():
+    assert triggers(do("CONDOR"), True)
+    assert triggers(CoreDecision(kind="DECLINE", basis="full_gap"), True)
+    assert not triggers(do("CONDOR"), False)
+    assert not triggers(CoreDecision(kind="ASK", basis="fact_agent"), True)
+    assert not triggers(CoreDecision(kind="CLARIFY", basis="goal_unclear"), True)
+    assert not triggers(CoreDecision(kind="DO", basis="tool"), True)
+
+
+def test_a_menu_reading_that_acts_holds_nothing():
+    assert held_core(do("CONDOR"), decision(), menu("DO"), TASK) is None
+    assert held_core(do("CONDOR"), decision(), menu("DECLINE"), TASK) is None
+    assert held_core(do("CONDOR"), decision(), None, TASK) is None
+
+
+def test_a_verified_condition_doubt_is_asked_as_a_fact_and_the_call_is_kept():
+    held = held_core(do("CONDOR"), decision(), menu("ASK", intent(), condition()), TASK)
+    assert held.kind == "ASK" and held.basis == FACT_BASIS and not held.workflows
+    fact = held.facts[0]
+    assert fact.user_quote == DOUBT and "regulators linked to genes / genes linked to genes" in fact.question
+    assert not fact.contract_quote and not fact.depends_on and not fact.by_code
+    shadow = held.evidence["m_hold"]
+    assert shadow["source"] == "fact" and shadow["dimension"] == "input_network"
+    assert shadow["would_have"]["kind"] == "DO" and shadow["would_have"]["workflows"] == ["CONDOR"]
+
+
+def test_a_doubt_whose_words_are_not_in_the_request_asks_the_result_instead():
+    held = held_core(do("CONDOR"), decision(), menu("ASK", condition("words the user never wrote")), TASK)
+    assert held.kind == "CLARIFY" and held.basis == GOAL_BASIS and held.clarify.question
+    assert held.evidence["m_hold"]["source"] == "result"
+
+
+def test_an_intent_only_reading_asks_the_result():
+    held = held_core(CoreDecision(kind="DECLINE", basis="full_gap"), decision(), menu("CLARIFY", intent()), TASK)
+    assert held.kind == "CLARIFY" and held.basis == GOAL_BASIS and held.clarify.question
+
+
+def _reply(core):
+    from netzoo_agent_core.interpretation.ask_facts import ask_result
+    from netzoo_agent_core.interpretation.clarify_goal import clarify_result
+
+    state = {"decision": TaskDecision(action="no_tool", in_scope=True, should_execute=False, reason="r",
+                                      confidence=0.0, core=core).model_dump(mode="json")}
+    return (ask_result(state, lambda text, kind: text) or clarify_result(state, lambda text, kind: text))
+
+
+def test_the_held_replies_ask_and_claim_nothing():
+    asked = _reply(held_core(do("CONDOR"), decision(), menu("ASK", condition()), TASK))
+    assert asked.startswith(HOLD_OPENING) and f'You wrote: "{DOUBT}"' in asked
+    assert "contract:" not in asked and "nothing runs before you answer" in asked
+    clarified = _reply(held_core(do("CONDOR"), decision(), menu("ASK", intent()), TASK))
+    assert clarified.startswith(HOLD_OPENING) and "can't tell yet which result you want" not in clarified
+    assert "Nothing was selected and nothing runs before you answer." in clarified
+    other = _reply(CoreDecision(kind="ASK", basis="fact_agent", facts=held_core(
+        do("CONDOR"), decision(), menu("ASK", condition()), TASK).facts))
+    assert other.startswith("Before I choose a workflow, please tell me:")  # other ASKs keep their opening
+
+
+def test_a_held_ask_selects_and_runs_nothing():
+    from netzoo_agent_core.interpretation.core_decision import with_core
+
+    held = held_core(do("CONDOR"), decision(), menu("ASK", condition()), TASK)
+    after = with_core(decision().model_copy(update={"action": "run_condor", "should_execute": True}), held)
+    assert after.action == "no_tool" and not after.should_execute and not after.matched_actions
+
+
+def test_the_task_keeps_a_held_question_as_pending():
+    from netzoo_agent_core.engine.task_updates import _pending
+
+    asked = held_core(do("CONDOR"), decision(), menu("ASK", condition()), TASK)
+    pending = _pending(asked.model_dump(mode="json"))
+    assert len(pending) == 1 and pending[0].source == "agent" and pending[0].user_quote == DOUBT
+    clarified = held_core(do("CONDOR"), decision(), menu("ASK", intent()), TASK)
+    assert [p.source for p in _pending(clarified.model_dump(mode="json"))] == ["goal"]
+
+
+def test_first_turn_counts_user_messages_and_rounds():
+    user = SimpleNamespace(type="human", content="x")
+    assert m_hold_call.first_turn({"messages": [user]})
+    assert not m_hold_call.first_turn({"messages": [user, SimpleNamespace(type="ai", content="y"), user]})
+    assert not m_hold_call.first_turn({"messages": [user], "task_state": {"rounds": 1}})
+
+
+def _hook(monkeypatch, *, read=None, focused=None, decided=None, raises=None):
+    from netzoo_agent_core.graph import menu_reading_call
+    from netzoo_agent_core.interpretation import menu_decision
+
+    events, calls = [], []
+    monkeypatch.setattr(m_hold_call, "record_event", lambda *a: events.append((a[2], a[4])))
+    monkeypatch.setattr(m_hold_call, "_llm", lambda: object())
+
+    def read_menu(task, llm):
+        calls.append("read")
+        if raises:
+            raise raises
+        return read
+
+    monkeypatch.setattr(menu_reading_call, "read_menu", read_menu)
+    monkeypatch.setattr(menu_reading_call, "read_focused", lambda task, first, llm: (focused, ()))
+    monkeypatch.setattr(menu_decision, "decide_menu", lambda reading, task: decided)
+    return events, calls
+
+
+def test_the_hook_is_off_by_default_and_never_touches_the_turns_usage(monkeypatch):
+    read = menu_reading_call_read()
+    events, calls = _hook(monkeypatch, read=read, decided=menu("ASK", condition()))
+    state, usage, core = {"messages": [SimpleNamespace(type="human", content=TASK)]}, LLMUsage(budget_tokens=1), do("CONDOR")
+    context = SimpleNamespace(price_catalog=None)
+    monkeypatch.delenv("NETZOO_M_HOLD", raising=False)
+    out = m_hold_call.apply_m_hold(context, state, decision(), core, TASK, usage, [])
+    assert out[0] is core and out[1] is usage and not calls and not events  # off: nothing read, nothing recorded
+    monkeypatch.setenv("NETZOO_M_HOLD", "1")
+    held, used, _ = m_hold_call.apply_m_hold(context, state, decision(), core, TASK, usage, [])
+    assert held.basis == FACT_BASIS and used is usage and calls == ["read"]
+    kind, payload = events[-1]
+    assert kind == "shadow.m_hold" and payload["status"] == "held"
+    assert payload["would_have"]["kind"] == "DO" and payload["held"]["source"] == "fact"
+    agreed = _hook(monkeypatch, read=read, decided=menu("DO"))[0]
+    kept, *_ = m_hold_call.apply_m_hold(context, state, decision(), core, TASK, usage, [])
+    assert kept is core and agreed[-1][1]["status"] == "agrees"
+
+
+def test_the_hook_reads_nothing_on_a_later_turn_or_an_asking_call(monkeypatch):
+    monkeypatch.setenv("NETZOO_M_HOLD", "1")
+    events, calls = _hook(monkeypatch, read=menu_reading_call_read(), decided=menu("ASK", condition()))
+    context, usage = SimpleNamespace(price_catalog=None), LLMUsage(budget_tokens=1)
+    user = SimpleNamespace(type="human", content=TASK)
+    later = {"messages": [user, SimpleNamespace(type="ai", content="?"), user]}
+    assert m_hold_call.apply_m_hold(context, later, decision(), do("CONDOR"), TASK, usage, [])[0].kind == "DO"
+    asking = CoreDecision(kind="ASK", basis="fact_agent")
+    assert m_hold_call.apply_m_hold(context, {"messages": [user]}, decision(), asking, TASK, usage, [])[0] is asking
+    assert not calls and [payload["status"] for _, payload in events] == ["not_triggered", "not_triggered"]
+
+
+def test_a_failed_read_leaves_the_call_as_it_was(monkeypatch):
+    monkeypatch.setenv("NETZOO_M_HOLD", "1")
+    state, usage, core = {"messages": [SimpleNamespace(type="human", content=TASK)]}, LLMUsage(budget_tokens=1), do("X")
+    context = SimpleNamespace(price_catalog=None)
+    events, _ = _hook(monkeypatch, raises=RuntimeError("provider down"))
+    assert m_hold_call.apply_m_hold(context, state, decision(), core, TASK, usage, [])[0] is core
+    assert events[-1][1]["status"] == "read_failed"
+    events, _ = _hook(monkeypatch, read=menu_reading_call_read(failed=True), decided=menu("ASK", condition()))
+    assert m_hold_call.apply_m_hold(context, state, decision(), core, TASK, usage, [])[0] is core
+    assert events[-1][1]["status"] == "read_failed"
+
+
+def menu_reading_call_read(failed: bool = False):
+    from netzoo_agent_core.graph.menu_reading_call import MenuRead
+
+    return MenuRead(reading=MenuReading(status="failed" if failed else "read"))
