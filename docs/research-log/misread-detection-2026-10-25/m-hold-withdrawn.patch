+the reply views without importing it (a leaf, so the views stay out of its imports)."""
+
+from __future__ import annotations
+
+__all__ = ["FACT_BASIS", "GOAL_BASIS", "HOLD_OPENING"]
+
+FACT_BASIS = "menu_hold"
+GOAL_BASIS = "menu_hold_goal"
+HOLD_OPENING = "Before I run or decline anything, one question:"
