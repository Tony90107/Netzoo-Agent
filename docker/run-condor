#!/usr/bin/env python3
"""Run a small CONDOR community-detection trial from a bipartite edge list."""

from __future__ import annotations

import argparse
import inspect
import sys
from pathlib import Path

import numpy as np
import pandas as pd

try:
    from netzoo_table_io import read_condor_edges
    from netzoo_agent_core.path_safety import condor_artifact_paths
except ModuleNotFoundError:
    project_scripts = Path(__file__).resolve().parents[1] / "scripts"
    sys.path.insert(0, str(project_scripts))
    from netzoo_table_io import read_condor_edges
    from netzoo_agent_core.path_safety import condor_artifact_paths


class CondorExecutionError(RuntimeError):
    """Raised when CONDOR cannot prove that the requested run completed."""


def read_edges(path: Path) -> pd.DataFrame:
    try:
        edges, info = read_condor_edges(path)
    except (OSError, ValueError) as error:
        raise SystemExit(str(error)) from error
    print(
        f"Read {len(edges)} edges as {info.delimiter_name}; "
        f"skipped {len(info.skiprows)} annotation/comment row(s)."
    )
    return edges


def import_condor_object():
    candidates = [
        ("netZooPy.condor.condor", "condor_object"),
        ("netZooPy.condor", "condor_object"),
        ("netZooPy.condor.condor", "Condor"),
        ("netZooPy.condor", "Condor"),
    ]
    errors = []
    for module_name, attr_name in candidates:
        try:
            module = __import__(module_name, fromlist=[attr_name])
            return getattr(module, attr_name)
        except Exception as error:  # noqa: BLE001 - report every attempted API.
            errors.append(f"{module_name}.{attr_name}: {type(error).__name__}: {error}")
    raise SystemExit("Could not import netZooPy CONDOR API:\n" + "\n".join(errors))


def build_condor_object(condor_class, edges: pd.DataFrame):
    attempts = [
        lambda: condor_class(dataframe=edges),
        lambda: condor_class(dataframe=edges[["source", "target", "weight"]]),
        lambda: condor_class(
            dataframe=edges.rename(columns={"source": "reg", "target": "tar"})
        ),
        lambda: condor_class(edges),
        lambda: condor_class(edges[["source", "target"]]),
        lambda: condor_class(edges.rename(columns={"source": "reg", "target": "tar"})),
    ]
    signature = str(inspect.signature(condor_class))
    errors = []
    for attempt in attempts:
        try:
            return attempt()
        except Exception as error:  # noqa: BLE001 - keep probing compatible constructors.
            errors.append(f"{type(error).__name__}: {error}")
    raise CondorExecutionError(
        "Could not construct CONDOR object. Constructor signature: "
        f"{signature}\n" + "\n".join(errors)
    )


def run_first_supported(phase: str, candidates) -> str:
    """Run the first successful API candidate and preserve every failure."""
    errors = []
    for label, call in candidates:
        try:
            call()
            return label
        except Exception as error:  # noqa: BLE001 - all probes are reported.
            errors.append(f"{label}: {type(error).__name__}: {error}")
    raise CondorExecutionError(
        f"CONDOR {phase} failed for every supported API:\n" + "\n".join(errors)
    )


def run_condor(obj) -> tuple[str, str]:
    initialization_method = run_first_supported(
        "initialization",
        (
            (
                "initial_community(method='LDN')",
                lambda: obj.initial_community(method="LDN"),
            ),
            ("initial_community()", lambda: obj.initial_community()),
        ),
    )
    optimization_method = run_first_supported(
        "optimization",
        (
            (
                "brim(deltaQmin='def', c='def')",
                lambda: obj.brim(deltaQmin="def", c="def"),
            ),
            ("brim()", lambda: obj.brim()),
            ("condor_run()", lambda: obj.condor_run()),
            ("run()", lambda: obj.run()),
        ),
    )
    return initialization_method, optimization_method


def final_scores(obj) -> dict | None:
    """Regulator memberships and core scores from BRIM's final target assignment.

    netZooPy 0.11.0 (60bcaf5, also upstream HEAD on 2026-10-08) has two defects here:
    `brim()` writes `reg_memb` from the initial assignment R0 instead of its final
    sweep, and `qscores()` reads a "com" column that `brim()` names "community" and
    calls `matrices(c)` without its `resolution` argument. So the regulators are
    reassigned with one right sweep against the final targets (which can only keep
    or raise the bipartite modularity), and the core scores are computed as in
    `qscores()` (Platig et al. 2016): a node's share of its community's modularity,
    target j: (B R)[j, k] / 2m / Q_k, regulator i: (T' B)[k, i] / 2m / Q_k, so each
    community's scores sum to 1. A community with Q_k <= 0 gets no score (NaN).

    Returns None when the object has no `matrices` method (a stand-in object).
    """
    if not callable(getattr(obj, "matrices", None)):
        return None
    reg, tar = required_memberships(obj)
    slots = 1 + int(max(reg.iloc[:, 1].max(), tar.iloc[:, 1].max()))
    B, m, T, _, gn, rg = obj.matrices(slots, 1)
    B = np.asarray(B, dtype=float)
    TtB = T.transpose() @ B  # communities x regulators
    reg_comm = TtB.argmax(axis=0)
    R = np.zeros((len(rg), slots))
    R[np.arange(len(rg)), reg_comm] = 1
    q_coms = np.diagonal(T.transpose() @ B @ R) / m
    BR = B @ R  # targets x communities
    tar_comm = T.argmax(axis=1)

    def score(raw: np.ndarray, communities: np.ndarray) -> list[float]:
        shares = q_coms[communities]
        return [float(value / (2 * m) / share) if share > 0 else float("nan")
                for value, share in zip(raw, shares)]

    reg_names = list(rg)
    tar_names = list(gn)
    reg_memb = pd.DataFrame({"reg": reg_names, "community": reg_comm})
    reg_q = reg_memb.assign(qscore=score(TtB[reg_comm, np.arange(len(rg))], reg_comm))
    tar_q = pd.DataFrame({"tar": tar_names, "community": tar_comm}).assign(
        qscore=score(BR[np.arange(len(gn)), tar_comm], tar_comm))
    return {
        "reg_memb": reg_memb,
        "reg_qscores": reg_q,
        "tar_qscores": tar_q,
        "modularity": float(q_coms.sum()),
        "reassigned_regulators": int((reg.set_index(reg.columns[0]).iloc[:, 0]
                                      .reindex(reg_names).to_numpy() != reg_comm).sum()),
    }


def required_memberships(obj) -> tuple[pd.DataFrame, pd.DataFrame]:
    """Return both required membership tables or fail the run."""
    memberships = []
    problems = []
    for name in ("reg_memb", "tar_memb"):
        value = getattr(obj, name, None)
        if not isinstance(value, pd.DataFrame):
            problems.append(f"{name} is not a pandas DataFrame")
        elif value.empty:
            problems.append(f"{name} is empty")
        else:
            memberships.append(value)
    if problems:
        raise CondorExecutionError("; ".join(problems))
    return memberships[0], memberships[1]


def write_outputs(
    obj,
    edges: pd.DataFrame,
    artifact_paths: dict[str, Path],
    *,
    initialization_method: str,
    optimization_method: str,
) -> list[Path]:
    reg_memb, tar_memb = required_memberships(obj)
    scores = final_scores(obj)
    if scores is None:
        raise CondorExecutionError(
            "CONDOR object has no matrices(); core scores cannot be computed."
        )
    reg_memb = scores["reg_memb"]
    output_dir = artifact_paths["edges.tsv"].parent
    output_dir.mkdir(parents=True, exist_ok=True)
    edge_path = artifact_paths["edges.tsv"]
    edges.to_csv(edge_path, sep="\t", index=False)
    reg_memb.to_csv(artifact_paths["reg_memb.tsv"], sep="\t", index=False)
    tar_memb.to_csv(artifact_paths["tar_memb.tsv"], sep="\t", index=False)
    scores["reg_qscores"].to_csv(artifact_paths["reg_qscores.tsv"], sep="\t", index=False)
    scores["tar_qscores"].to_csv(artifact_paths["tar_qscores.tsv"], sep="\t", index=False)

    summary_path = artifact_paths["summary.txt"]
    with summary_path.open("w", encoding="utf-8") as handle:
        handle.write("CONDOR trial summary\n")
        handle.write(f"edges: {len(edges)}\n")
        handle.write(f"sources: {edges['source'].nunique()}\n")
        handle.write(f"targets: {edges['target'].nunique()}\n")
        handle.write(f"initialization_method: {initialization_method}\n")
        handle.write(f"optimization_method: {optimization_method}\n")
        handle.write(f"modularity: {scores['modularity']}\n")
        handle.write(
            "regulator memberships: one right sweep against the final targets "
            f"(netZooPy brim keeps the initial regulator assignment); "
            f"{scores['reassigned_regulators']} regulator(s) changed community\n"
        )
        handle.write(
            "core scores: each node's share of its community's modularity "
            "(Platig et al. 2016); NaN where a community's modularity is not positive\n"
        )

    written = [artifact_paths[suffix] for suffix in artifact_paths]
    for path in written:
        print(f"Wrote {path}")
    return written


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Run netZooPy CONDOR on a bipartite source-target-weight edge list."
    )
    parser.add_argument("-i", "--input", required=True, help="CSV/TSV edge list")
    parser.add_argument("-o", "--outdir", required=True, help="Output directory")
    parser.add_argument("--prefix", default="condor", help="Output filename prefix")
    args = parser.parse_args()

    try:
        artifact_paths = condor_artifact_paths(args.outdir, args.prefix)
        edges = read_edges(Path(args.input))
        condor_class = import_condor_object()
        obj = build_condor_object(condor_class, edges)
        initialization_method, optimization_method = run_condor(obj)
        write_outputs(
            obj,
            edges,
            artifact_paths,
            initialization_method=initialization_method,
            optimization_method=optimization_method,
        )
    except (CondorExecutionError, ValueError) as error:
        raise SystemExit(str(error)) from error
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
