{
  "method": "SAMBAR",
  "inputs": {
    "mutation_file": "/data/mut.ucec.csv",
    "exon_size_file": "/data/esizef.csv",
    "cancer_gene_file": "/data/genes.txt",
    "pathway_file": "/data/h.all.v6.1.symbols.gmt"
  },
  "parameters": {
    "norm_patient": true,
    "kmin": 2,
    "kmax": 4,
    "gmt_msigdb": true,
    "subset_cancer_genes": true,
    "distance": "binomial",
    "linkage": "complete",
    "cluster": false
  },
  "artifacts": [
    "mt_out.csv",
    "pt_out.csv"
  ]
}
