# Copy this file to .env or export these variables in your shell.
# Do not commit real API keys.

OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Response model; it may be changed independently from the cheap Router.
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_ROUTER_MODEL=openai/gpt-4o
OPENROUTER_SEMANTIC_MODEL=openai/gpt-4o
NETZOO_RESPONSE_MODEL_ALLOWLIST=openai/gpt-4o
NETZOO_ROUTER_MODEL_ALLOWLIST=openai/gpt-4o
NETZOO_ROUTER_MAX_TOKENS=500
NETZOO_RESPONSE_MAX_TOKENS=800
NETZOO_MAX_TASK_TOKENS=20000
NETZOO_LLM_TIMEOUT_SECONDS=30
NETZOO_TOOL_TIMEOUT_SECONDS=86400
NETZOO_RETENTION_DAYS=30
NETZOO_SESSION_HARD_RETENTION_DAYS=180
NETZOO_EPISODE_RETENTION_DAYS=180
NETZOO_EPISODE_MAX_COUNT=200
NETZOO_EPISODE_MAX_MB=10

# Optional but recommended for higher Context7 rate limits.
CONTEXT7_API_KEY=ctx7-your-key-here
CONTEXT7_MCP_URL=https://mcp.context7.com/mcp

# General web search through the official Tavily remote MCP.
TAVILY_API_KEY=tvly-your-key-here
WEBSEARCH_MCP_URL=https://mcp.tavily.com/mcp

# Observer / browser Dashboard backend. Generate each secret separately with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
NETZOO_OBSERVER_URL=http://observer-api:8000
# Keep false for public URLs; Compose overrides this only on its private network.
NETZOO_OBSERVER_ALLOW_INSECURE=false
# Must stay true for any public deployment. Set false only for loopback UI testing.
NETZOO_OBSERVER_SHARE_COOKIE_SECURE=true
NETZOO_OBSERVER_PORT=8000
NETZOO_OBSERVER_CREDENTIAL_PEPPER=replace-with-at-least-32-random-bytes
NETZOO_OBSERVER_AGENT_KEY=replace-with-at-least-32-random-bytes
NETZOO_OBSERVER_ADMIN_KEY=replace-with-at-least-32-random-bytes
NETZOO_OBSERVER_DB_PASSWORD=replace-with-a-long-random-password
NETZOO_OBSERVER_OBJECT_ACCESS_KEY=replace-with-a-random-access-key
NETZOO_OBSERVER_OBJECT_SECRET_KEY=replace-with-at-least-32-random-bytes
